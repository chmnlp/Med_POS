<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:BillKro.Desktop"
                    xmlns:views="clr-namespace:BillKro.Desktop.Views">

    <local:HasValueToVisibilityConverter x:Key="HasValueToVisibility" />
    <local:HasValueToVisibilityConverter x:Key="NoValueToVisibility" Invert="True" />
    <local:InverseBoolConverter x:Key="InverseBool" />
    <local:PaymentModeTextConverter x:Key="PaymentModeText" />
    <local:ZeroBlankConverter x:Key="ZeroBlank" />
    <local:ExpiryStatusConverter x:Key="ExpiryStatus" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility" />
    <local:UpperCaseConverter x:Key="UpperCase" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Brand colours that look the same in light and dark mode (the sidebar and hero panels are always dark teal). -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#0B3B38" Offset="0" />
        <GradientStop Color="#0A2A28" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#F0FDFA" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#99CCFBF1" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SidebarAccentBrush" Color="#5EEAD4" />
    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2DD4BF" Offset="0" />
        <GradientStop Color="#0D9488" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AvatarBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0" />
        <GradientStop Color="#EA580C" Offset="1" />
    </LinearGradientBrush>

    <!-- Tile tones: soft background + strong foreground, readable in both themes. -->
    <SolidColorBrush x:Key="ToneBlueSoft" Color="#263B82F6" />
    <SolidColorBrush x:Key="ToneBlue" Color="#3B82F6" />
    <SolidColorBrush x:Key="ToneGreenSoft" Color="#2622C55E" />
    <SolidColorBrush x:Key="ToneGreen" Color="#16A34A" />
    <SolidColorBrush x:Key="ToneAmberSoft" Color="#2EF59E0B" />
    <SolidColorBrush x:Key="ToneAmber" Color="#D97706" />
    <SolidColorBrush x:Key="ToneRedSoft" Color="#26EF4444" />
    <SolidColorBrush x:Key="ToneRed" Color="#DC2626" />
    <SolidColorBrush x:Key="TonePurpleSoft" Color="#268B5CF6" />
    <SolidColorBrush x:Key="TonePurple" Color="#8B5CF6" />
    <SolidColorBrush x:Key="ToneTealSoft" Color="#2614B8A6" />
    <SolidColorBrush x:Key="ToneTeal" Color="#0D9488" />

    <DropShadowEffect x:Key="SoftShadow" BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.10" Color="#000000" />
    <DropShadowEffect x:Key="GlowShadow" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.28" Color="#0F766E" />

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Small caps label above a group of fields or a stat ("TODAY'S SALES"). -->
    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,10,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Card lifted off the page with a soft shadow; for the few panels that deserve attention. -->
    <Style x:Key="RaisedCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
        <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
    </Style>

    <!-- Error banner shown above forms and lists. -->
    <Style x:Key="ErrorBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="InfoBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="TotalLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style x:Key="TotalValue" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    </Style>

    <Style x:Key="NumberCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="StockCell" TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ExpiryCell" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ExpiryDate, Converter={StaticResource ExpiryStatus}}" Value="Expired">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ExpiryDate, Converter={StaticResource ExpiryStatus}}" Value="Near expiry">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InactiveCell" TargetType="TextBlock">
        <Setter Property="Text" Value="" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="False">
                <Setter Property="Text" Value="Inactive" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Button content: glyph from Tag + text from Content. Keeps the theme's own Button style. -->
    <DataTemplate x:Key="IconContent">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"
                       Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- Keyboard key, e.g. <ContentControl Style="{StaticResource Keycap}" Content="F12" /> -->
    <Style x:Key="Keycap" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border MinWidth="22" Padding="6,1,6,2" CornerRadius="5" BorderThickness="1,1,1,2"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrongStrokeColorDisabledBrush}">
                        <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A key followed by what it does, for shortcut strips. Content = key, Tag = action. -->
    <Style x:Key="ShortcutHint" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Keycap}" Content="{TemplateBinding Content}" />
                        <TextBlock Text="{TemplateBinding Tag}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded square holding a glyph, tinted by Background / Foreground. -->
    <Style x:Key="IconBadge" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
    </Style>

    <!-- Small rounded label ("Sch H1", "Walk-in"). -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
    </Style>

    <!-- Initials in a circle. -->
    <Style x:Key="Avatar" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="{StaticResource AvatarBrush}" />
    </Style>

    <!-- Borderless icon-only button; glyph in Content. -->
    <Style x:Key="GhostIconButton" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same, for the always-dark sidebar. -->
    <Style x:Key="SidebarIconButton" TargetType="Button" BasedOn="{StaticResource GhostIconButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar navigation entry with a glowing selection pill. -->
    <Style x:Key="NavItemContainer" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,1">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent" />
                        <Border x:Name="Pill" Width="4" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource SidebarAccentBrush}" Opacity="0" />
                        <ContentPresenter Margin="14,9,10,9" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                            <Setter TargetName="Pill" Property="Opacity" Value="1" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Big tappable card button used for dashboard quick actions. Tag = glyph, Content = title, ToolTip = hint. -->
    <Style x:Key="ActionTile" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="12" Padding="16,14" BorderThickness="1"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" /></Setter.Value>
                            </Setter>
                            <Setter TargetName="Bg" Property="RenderTransformOrigin" Value="0.5,0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Coloured chips: <Border Style="{StaticResource ChipRed}"><TextBlock Text="Cancelled" /></Border> -->
    <Style x:Key="ToneChip" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,1,8,2" />
        <Setter Property="TextElement.FontSize" Value="11.5" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrandBrush}" />
    </Style>
    <Style x:Key="ChipRed" TargetType="Border" BasedOn="{StaticResource ToneChip}">
        <Setter Property="Background" Value="{StaticResource ToneRedSoft}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource ToneRed}" />
    </Style>
    <Style x:Key="ChipAmber" TargetType="Border" BasedOn="{StaticResource ToneChip}">
        <Setter Property="Background" Value="{StaticResource ToneAmberSoft}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource ToneAmber}" />
    </Style>
    <Style x:Key="ChipBlue" TargetType="Border" BasedOn="{StaticResource ToneChip}">
        <Setter Property="Background" Value="{StaticResource ToneBlueSoft}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource ToneBlue}" />
    </Style>
    <Style x:Key="ChipPurple" TargetType="Border" BasedOn="{StaticResource ToneChip}">
        <Setter Property="Background" Value="{StaticResource TonePurpleSoft}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TonePurple}" />
    </Style>
    <Style x:Key="ChipGreen" TargetType="Border" BasedOn="{StaticResource ToneChip}">
        <Setter Property="Background" Value="{StaticResource ToneGreenSoft}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource ToneGreen}" />
    </Style>
    <Style x:Key="ChipGrey" TargetType="Border" BasedOn="{StaticResource ToneChip}">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- "Inactive" chip for master lists; hidden for active records. -->
    <DataTemplate x:Key="InactiveChipCell">
        <Border Style="{StaticResource ChipGrey}" Margin="4,0">
            <Border.Visibility>
                <Binding Path="IsActive" Converter="{StaticResource InvertedBoolToVisibility}" />
            </Border.Visibility>
            <TextBlock Text="Inactive" />
        </Border>
    </DataTemplate>

    <!-- Compact figure tile for page summaries. Tag = label, Content = value. -->
    <Style x:Key="SummaryTile" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="MinWidth" Value="170" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Style="{StaticResource Card}" Padding="16,10">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Overline}" />
                            <ContentPresenter Margin="0,2,0,0" TextElement.FontSize="20" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section heading with a brand glyph. Tag = glyph, Content = text. -->
    <Style x:Key="SectionHeader" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconBadge}" Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" FontSize="14"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource BrandBrush}" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="16" TextElement.FontWeight="SemiBold" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="views:EmptyState">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,48,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:EmptyState">
                    <StackPanel>
                        <Grid Width="96" Height="96" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource BrandSoftBrush}" />
                            <Ellipse Margin="14" Fill="{DynamicResource BrandSoftBrush}" />
                            <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding Glyph}" FontSize="30"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource BrandBrush}" />
                        </Grid>
                        <TextBlock Text="{TemplateBinding Title}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="{TemplateBinding Hint}" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tabs: a segmented pill bar. The selected tab lifts out of the track as a small card. -->
    <!-- Colours and weight go on the header presenter only: TabItem properties would be inherited by the tab's page content. -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" CornerRadius="8" Padding="18,7,18,8" Margin="0,0,2,0" Background="Transparent"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter x:Name="Header" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" TextElement.FontSize="13.5"
                                          TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlSolidFillColorDefaultBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.12" Color="#000000" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource BrandBrush}" />
                            <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel KeyboardNavigation.TabNavigation="Local">
                        <Border DockPanel.Dock="Top" HorizontalAlignment="Left" CornerRadius="11" Padding="4"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nested tabs (sections inside a tab): text tabs with a brand underline on the selected one. -->
    <Style x:Key="SubTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,0,22,0" Background="Transparent">
                        <ContentPresenter x:Name="Header" ContentSource="Header" Margin="0,6,0,10" RecognizesAccessKey="True"
                                          TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border x:Name="Bar" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom"
                                Background="{DynamicResource BrandBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource BrandBrush}" />
                            <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubTabControl" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource SubTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel KeyboardNavigation.TabNavigation="Local">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <TabPanel IsItemsHost="True" />
                        </Grid>
                        <ContentPresenter ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search field look: magnifier glyph inside the box. Wrap a TextBox in a Grid and add this TextBlock after it. -->
    <Style x:Key="SearchGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="Text" Value="&#xE721;" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

</ResourceDictionary>
