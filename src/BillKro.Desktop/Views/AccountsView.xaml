<UserControl x:Class="BillKro.Desktop.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillKro.Desktop.Views">
    <UserControl.Resources>
        <Style x:Key="OverdueCell" TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding StatusMessage, Converter={StaticResource HasValueToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
        <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,0,0,-36" Content="Refresh" Tag="&#xE72C;"
                ContentTemplate="{StaticResource IconContent}" Command="{Binding RefreshCommand}" />

        <TabControl SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Customers owe us">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Receive payment" Tag="&#xE8C7;" ContentTemplate="{StaticResource IconContent}"
                                    Style="{DynamicResource AccentButtonStyle}" Command="{Binding ReceiveCommand}" />
                            <Button Content="Statement" Tag="&#xE8A5;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0" Command="{Binding CustomerStatementCommand}" />
                            <Button Content="Copy reminder" Tag="&#xE8C8;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0"
                                    Command="{Binding CopyReminderCommand}" ToolTip="Copies a payment reminder to paste into WhatsApp or SMS" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource SummaryTile}" Tag="TOTAL DUE"
                                            Content="{Binding ReceivableReport.Outstanding, FallbackValue='–'}" ContentStringFormat="₹ {0:N2}" />
                            <ContentControl Style="{StaticResource SummaryTile}" Tag="OVERDUE" Foreground="{StaticResource ToneRed}"
                                            Content="{Binding ReceivableReport.Overdue, FallbackValue='–'}" ContentStringFormat="₹ {0:N2}" />
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <DataGrid x:Name="ReceivablesGrid" ItemsSource="{Binding Receivables}" SelectedItem="{Binding SelectedReceivable}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110" />
                                <DataGridTextColumn Header="Days" Binding="{Binding CreditDays}" Width="50" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Due" Binding="{Binding Outstanding, StringFormat=N2}" Width="105">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"><Setter Property="FontWeight" Value="SemiBold" /></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Not due" Binding="{Binding NotDue, StringFormat='#,##0.00;-#,##0.00;–'}" Width="95" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="1–30" Binding="{Binding Overdue1To30, StringFormat='#,##0.00;-#,##0.00;–'}" Width="90" ElementStyle="{StaticResource OverdueCell}" />
                                <DataGridTextColumn Header="31–60" Binding="{Binding Overdue31To60, StringFormat='#,##0.00;-#,##0.00;–'}" Width="90" ElementStyle="{StaticResource OverdueCell}" />
                                <DataGridTextColumn Header="61–90" Binding="{Binding Overdue61To90, StringFormat='#,##0.00;-#,##0.00;–'}" Width="90" ElementStyle="{StaticResource OverdueCell}" />
                                <DataGridTextColumn Header="90+" Binding="{Binding Overdue90Plus, StringFormat='#,##0.00;-#,##0.00;–'}" Width="90" ElementStyle="{StaticResource OverdueCell}" />
                                <DataGridTextColumn Header="Overdue since" Binding="{Binding OldestDue, StringFormat=dd-MM-yyyy}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <views:EmptyState Glyph="&#xE73E;" Title="No customer owes you money" Hint="Credit sales and opening balances show up here until they are paid."
                                          Visibility="{Binding HasItems, ElementName=ReceivablesGrid, Converter={StaticResource InvertedBoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="We owe suppliers" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Pay supplier" Tag="&#xE8C7;" ContentTemplate="{StaticResource IconContent}"
                                    Style="{DynamicResource AccentButtonStyle}" Command="{Binding PayCommand}" />
                            <Button Content="Statement" Tag="&#xE8A5;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0" Command="{Binding SupplierStatementCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource SummaryTile}" Tag="TOTAL PAYABLE"
                                            Content="{Binding PayableReport.Outstanding, FallbackValue='–'}" ContentStringFormat="₹ {0:N2}" />
                            <ContentControl Style="{StaticResource SummaryTile}" Tag="PAST DUE" Foreground="{StaticResource ToneAmber}"
                                            Content="{Binding PayableReport.Overdue, FallbackValue='–'}" ContentStringFormat="₹ {0:N2}" />
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <DataGrid x:Name="PayablesGrid" ItemsSource="{Binding Payables}" SelectedItem="{Binding SelectedPayable}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Supplier" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110" />
                                <DataGridTextColumn Header="Days" Binding="{Binding CreditDays}" Width="50" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Payable" Binding="{Binding Outstanding, StringFormat=N2}" Width="105" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Not due" Binding="{Binding NotDue, StringFormat='#,##0.00;-#,##0.00;–'}" Width="95" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="1–30" Binding="{Binding Overdue1To30, StringFormat='#,##0.00;-#,##0.00;–'}" Width="90" ElementStyle="{StaticResource OverdueCell}" />
                                <DataGridTextColumn Header="31–60" Binding="{Binding Overdue31To60, StringFormat='#,##0.00;-#,##0.00;–'}" Width="90" ElementStyle="{StaticResource OverdueCell}" />
                                <DataGridTextColumn Header="61–90" Binding="{Binding Overdue61To90, StringFormat='#,##0.00;-#,##0.00;–'}" Width="90" ElementStyle="{StaticResource OverdueCell}" />
                                <DataGridTextColumn Header="90+" Binding="{Binding Overdue90Plus, StringFormat='#,##0.00;-#,##0.00;–'}" Width="90" ElementStyle="{StaticResource OverdueCell}" />
                                <DataGridTextColumn Header="Due since" Binding="{Binding OldestDue, StringFormat=dd-MM-yyyy}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <views:EmptyState Glyph="&#xE73E;" Title="Nothing payable to suppliers" Hint="Credit purchases show up here until you pay them."
                                          Visibility="{Binding HasItems, ElementName=PayablesGrid, Converter={StaticResource InvertedBoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Receipts">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                        <Button Content="View / print" Tag="&#xE749;" ContentTemplate="{StaticResource IconContent}" Command="{Binding PrintReceiptCommand}" />
                        <Button Content="Cancel receipt" Tag="&#xE711;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0" Command="{Binding CancelReceiptCommand}" />
                    </StackPanel>
                    <Grid>
                        <DataGrid x:Name="ReceiptsGrid" ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNo}" Width="130" />
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy HH:mm}" Width="130" />
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="2*" />
                                <DataGridTextColumn Header="Mode" Binding="{Binding Mode, Converter={StaticResource PaymentModeText}}" Width="110" />
                                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="By" Binding="{Binding CreatedBy}" Width="110" />
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,0" VerticalAlignment="Center">
                                                <Border x:Name="Ok" Style="{StaticResource ChipGreen}"><TextBlock Text="Active" /></Border>
                                                <Border x:Name="Cancelled" Style="{StaticResource ChipRed}" Visibility="Collapsed"><TextBlock Text="Cancelled" /></Border>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter TargetName="Ok" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Cancelled" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <views:EmptyState Glyph="&#xE8C7;" Title="No receipts yet" Hint="Use Receive payment on the first tab when a customer pays their dues."
                                          Visibility="{Binding HasItems, ElementName=ReceiptsGrid, Converter={StaticResource InvertedBoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Supplier payments" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                        <Button Content="Cancel payment" Tag="&#xE711;" ContentTemplate="{StaticResource IconContent}" Command="{Binding CancelPaymentCommand}" />
                    </StackPanel>
                    <Grid>
                        <DataGrid x:Name="PaymentsGrid" ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Payment" Binding="{Binding PaymentNo}" Width="130" />
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy HH:mm}" Width="130" />
                                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="2*" />
                                <DataGridTextColumn Header="Mode" Binding="{Binding Mode, Converter={StaticResource PaymentModeText}}" Width="110" />
                                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,0" VerticalAlignment="Center">
                                                <Border x:Name="Ok" Style="{StaticResource ChipGreen}"><TextBlock Text="Active" /></Border>
                                                <Border x:Name="Cancelled" Style="{StaticResource ChipRed}" Visibility="Collapsed"><TextBlock Text="Cancelled" /></Border>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter TargetName="Ok" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Cancelled" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <views:EmptyState Glyph="&#xE8C7;" Title="No supplier payments yet" Hint="Use Pay supplier on the second tab to record a payment."
                                          Visibility="{Binding HasItems, ElementName=PaymentsGrid, Converter={StaticResource InvertedBoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
