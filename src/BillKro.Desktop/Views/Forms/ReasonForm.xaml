<UserControl x:Class="BillKro.Desktop.Views.Forms.ReasonForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440">
    <StackPanel>
        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <TextBlock Text="Reason *" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Reason}" />
    </StackPanel>
</UserControl>
