<UserControl x:Class="BillKro.Desktop.Views.Forms.CreditNotePickerForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440">
    <ListBox ItemsSource="{Binding Returns}" SelectedItem="{Binding Selected}" Height="220">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <TextBlock Margin="4">
                    <Run Text="{Binding ReturnNo, Mode=OneWay}" FontWeight="SemiBold" /> ·
                    <Run Text="{Binding ReturnDate, Mode=OneWay, StringFormat=dd-MM-yyyy HH:mm}" /> ·
                    <Run Text="{Binding Total, Mode=OneWay, StringFormat='₹ {0:N2}'}" /> ·
                    <Run Text="{Binding RefundMode, Mode=OneWay}" />
                </TextBlock>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
