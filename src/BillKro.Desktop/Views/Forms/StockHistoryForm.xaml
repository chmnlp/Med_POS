<UserControl x:Class="BillKro.Desktop.Views.Forms.StockHistoryForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="980">
    <StackPanel>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
        <DataGrid ItemsSource="{Binding Movements}" Height="440" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="When" Binding="{Binding At, StringFormat=dd-MM-yyyy HH:mm}" Width="130" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130" />
                <DataGridTextColumn Header="Ref." Binding="{Binding RefNo}" Width="130" />
                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="90" />
                <DataGridTextColumn Header="In / out" Binding="{Binding QtyChange, StringFormat=+0.###;-0.###}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=0.###}" Width="70" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="By" Binding="{Binding User}" Width="110" />
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
