<UserControl x:Class="BillKro.Desktop.Views.Forms.BarcodeSetupForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Items to do -->
        <DockPanel>
            <Grid DockPanel.Dock="Top">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,10,6"
                         AutomationProperties.Name="Search items" />
                <TextBlock Style="{StaticResource SearchGlyph}" />
                <TextBlock Text="Find an item by name, code or company" Style="{StaticResource Muted}" Margin="36,0,12,0" IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NoValueToVisibility}}" />
            </Grid>
            <DockPanel DockPanel.Dock="Top" Margin="0,8">
                <CheckBox DockPanel.Dock="Right" Content="Also items that have one" IsChecked="{Binding IncludeWithBarcode}"
                          ToolTip="Show every item, to correct a wrong barcode" />
                <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center">
                    <Run Text="{Binding Total, Mode=OneWay}" /> item(s) to do · <Run Text="{Binding SavedCount, Mode=OneWay}" /> saved
                </TextBlock>
            </DockPanel>
            <ListBox x:Name="ItemList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Height="380"
                     AutomationProperties.Name="Items">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                <Run Text="{Binding Code, Mode=OneWay}" /> · <Run Text="{Binding Pack, Mode=OneWay}" /> ·
                                <Run Text="{Binding Manufacturer, Mode=OneWay}" /><Run Text="{Binding Barcode, Mode=OneWay, StringFormat=' · {0}', TargetNullValue=''}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Scan -->
        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Now scanning for" Style="{StaticResource Overline}" />
                    <TextBlock Text="{Binding Selected.Name, TargetNullValue='All done'}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                        <Run Text="{Binding Selected.Pack, Mode=OneWay}" />
                        <Run Text="{Binding Selected.Mrp, Mode=OneWay, StringFormat='· MRP ₹{0:N2}'}" />
                    </TextBlock>

                    <TextBlock Text="Barcode" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                    <TextBox x:Name="ScanBox" Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}" FontSize="16"
                             AutomationProperties.Name="Barcode" PreviewKeyDown="OnScanKeyDown" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Save and next" Style="{DynamicResource AccentButtonStyle}" Command="{Binding SaveBarcodeCommand}" />
                        <Button Content="Skip" Margin="8,0,0,0" Command="{Binding SkipCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource InfoBanner}" Margin="0,12,0,0"
                    Visibility="{Binding StatusMessage, Converter={StaticResource HasValueToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Margin="0,12,0,0" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                       Text="Pick up the pack, scan it: the barcode is saved and the next item comes up. Scanners send Enter after the code, so you do not need to touch the keyboard. Items without a pack barcode can get printed labels instead (Print labels)." />
        </StackPanel>
    </Grid>
</UserControl>
