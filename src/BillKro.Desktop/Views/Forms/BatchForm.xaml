<UserControl x:Class="BillKro.Desktop.Views.Forms.BatchForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Batch number *" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding BatchNo}" CharacterCasing="Upper" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="2">
            <TextBlock Text="Expiry * (MM/YY, e.g. 03/27)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding ExpiryText}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0">
            <TextBlock Text="Mfg. (MM/YY)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding MfgText}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2">
            <TextBlock Text="Batch barcode (optional)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Barcode}" ToolTip="Scan it if the pack's barcode is different for each batch; Print labels fills one in otherwise" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0">
            <TextBlock Text="MRP" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Mrp, StringFormat=0.##, ValidatesOnExceptions=True}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Text="Sale rate (≤ MRP)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding SaleRate, StringFormat=0.##, ValidatesOnExceptions=True}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0">
            <TextBlock Text="Purchase rate" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding PurchaseRate, StringFormat=0.##, ValidatesOnExceptions=True}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="2"
                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Opening quantity" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding OpeningQty, StringFormat=0.###, ValidatesOnExceptions=True}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="0">
            <TextBlock Text="Wholesale rate (this lot)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding WholesaleRate, StringFormat=0.##, ValidatesOnExceptions=True}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="2">
            <TextBlock Text="Hospital rate (this lot)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding HospitalRate, StringFormat=0.##, ValidatesOnExceptions=True}" />
        </StackPanel>

        <TextBlock Grid.Row="5" Grid.ColumnSpan="3" Margin="0,16,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Rates left at 0 use the item's rates. Quantity changes after creation are made through stock adjustments so every change is recorded." />
    </Grid>
</UserControl>
