<UserControl x:Class="BillKro.Desktop.Views.Forms.MoneyForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BillKro.Desktop.ViewModels"
             Width="440">
    <!-- Shared by customer receipts and supplier payments (same field names). -->
    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16,10">
            <DockPanel>
                <TextBlock Text="Balance now" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding Outstanding, StringFormat='₹ {0:N2}'}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
        <TextBlock Text="Amount *" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Amount, StringFormat=0.##, ValidatesOnExceptions=True}" FontSize="16" />
        <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{x:Static vm:PaymentModes.All}" SelectedItem="{Binding Mode}">
            <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Converter={StaticResource PaymentModeText}}" /></DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock>
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                    <Setter Property="Text" Value="Reference (UPI / card approval — optional)" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NeedsReference}" Value="True">
                            <Setter Property="Text" Value="Cheque / transaction number *" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBox Text="{Binding Reference}" />
        <TextBlock Text="Note" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Note}" />
        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding After, StringFormat='Balance after: ₹ {0:N2}'}" />
    </StackPanel>
</UserControl>
