<UserControl x:Class="BillKro.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillKro.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="New user" Tag="&#xE710;" ContentTemplate="{StaticResource IconContent}"
                        Style="{DynamicResource AccentButtonStyle}" Command="{Binding NewCommand}" />
                <Button Content="Edit" Tag="&#xE70F;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0"
                        Command="{Binding EditCommand}" />
                <Button Content="Reset password" Tag="&#xE72E;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0"
                        Command="{Binding ResetPasswordCommand}" />
                <Button Content="Refresh" Tag="&#xE72C;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Cashiers bill and manage customers. Managers also manage items, stock and suppliers. Admins also manage users." />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource ErrorBanner}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
        </Border>

        <DataGrid Grid.Row="2" x:Name="ListGrid" ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False" MouseDoubleClick="OnDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" />
                <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="2*" />
                <DataGridTemplateColumn Header="Role" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="4,0" VerticalAlignment="Center">
                                <Border x:Name="CCashier" Style="{StaticResource ToneChip}" Visibility="Collapsed"><TextBlock Text="{Binding Role}" /></Border>
                                <Border x:Name="CManager" Style="{StaticResource ChipBlue}" Visibility="Collapsed"><TextBlock Text="{Binding Role}" /></Border>
                                <Border x:Name="CAdmin" Style="{StaticResource ChipPurple}" Visibility="Collapsed"><TextBlock Text="{Binding Role}" /></Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Role}" Value="Cashier"><Setter TargetName="CCashier" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding Role}" Value="Manager"><Setter TargetName="CManager" Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding Role}" Value="Admin"><Setter TargetName="CAdmin" Property="Visibility" Value="Visible" /></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="90" CellTemplate="{StaticResource InactiveChipCell}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
