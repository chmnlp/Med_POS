<UserControl x:Class="BillKro.Desktop.Views.DayEndView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillKro.Desktop.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,8">
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Print slip" Tag="&#xE749;" ContentTemplate="{StaticResource IconContent}" Command="{Binding PrintCommand}" />
                    <Button Content="Refresh" Tag="&#xE72C;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Day" Style="{StaticResource Muted}" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding Date}" Width="150" />
                    <CheckBox Content="All counters together" IsChecked="{Binding AllCounters}" Margin="16,0,0,0"
                              Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
                    <Border Style="{StaticResource ToneChip}" Margin="16,0,0,0"
                            Visibility="{Binding Summary.UserName, Converter={StaticResource HasValueToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Summary.UserName}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChipGreen}" Margin="8,0,0,0"
                            Visibility="{Binding IsClosed, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="Closed for the day" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>
            <Border Style="{StaticResource InfoBanner}" Visibility="{Binding StatusMessage, Converter={StaticResource HasValueToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- The day at a glance -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <ContentControl Style="{StaticResource SummaryTile}" Tag="BILLS" Content="{Binding Summary.Bills, FallbackValue='–'}" />
                <ContentControl Style="{StaticResource SummaryTile}" Tag="TOTAL SALES"
                                Content="{Binding Summary.SalesTotal, FallbackValue='–'}" ContentStringFormat="₹ {0:N2}" />
                <ContentControl Style="{StaticResource SummaryTile}" Tag="NET CASH TAKEN"
                                Content="{Binding Summary.NetCash, FallbackValue='–'}" ContentStringFormat="₹ {0:N2}" />
                <ContentControl Style="{StaticResource SummaryTile}" Tag="EXPECTED IN DRAWER" Margin="0" Foreground="{DynamicResource BrandBrush}"
                                Content="{Binding ExpectedCash}" ContentStringFormat="₹ {0:N2}" />
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Takings -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="18">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SectionHeader}" Tag="&#xE9D2;" Content="Takings" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Bills" Style="{StaticResource TotalLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding Summary.Bills}" Style="{StaticResource TotalValue}" />
                            <TextBlock Grid.Row="1" Text="Cancelled bills" Style="{StaticResource TotalLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.CancelledBills}" Style="{StaticResource TotalValue}" />
                            <TextBlock Grid.Row="2" Text="Cash" Style="{StaticResource TotalLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.CashSales, StringFormat=N2}" Style="{StaticResource TotalValue}" />
                            <TextBlock Grid.Row="3" Text="UPI" Style="{StaticResource TotalLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.UpiSales, StringFormat=N2}" Style="{StaticResource TotalValue}" />
                            <TextBlock Grid.Row="4" Text="Card" Style="{StaticResource TotalLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.CardSales, StringFormat=N2}" Style="{StaticResource TotalValue}" />
                            <TextBlock Grid.Row="5" Text="Credit (on account)" Style="{StaticResource TotalLabel}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Summary.CreditSales, StringFormat=N2}" Style="{StaticResource TotalValue}" />
                            <TextBlock Grid.Row="6" Text="Returns" Style="{StaticResource TotalLabel}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Summary.Returns}" Style="{StaticResource TotalValue}" />
                            <Border Grid.Row="7" Grid.ColumnSpan="2" Height="1" Margin="0,8,0,0" VerticalAlignment="Top"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock Grid.Row="7" Text="Total sales" FontWeight="SemiBold" Margin="0,14,0,0" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Summary.SalesTotal, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" Margin="0,14,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Cash drawer -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="18">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SectionHeader}" Tag="&#xE8C7;" Content="Cash drawer" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Cash sales" Style="{StaticResource TotalLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding Summary.CashSales, StringFormat=N2}" Style="{StaticResource TotalValue}" />
                            <TextBlock Grid.Row="1" Text="Less cash refunds" Style="{StaticResource TotalLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.CashRefunds, StringFormat='-#,##0.00;+#,##0.00;0.00'}" Style="{StaticResource TotalValue}" />
                            <TextBlock Grid.Row="2" Text="Add cash received on account" Style="{StaticResource TotalLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.CashReceipts, StringFormat=N2}" Style="{StaticResource TotalValue}" />
                            <TextBlock Grid.Row="3" Text="Less cash paid to suppliers" Style="{StaticResource TotalLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.CashPayouts, StringFormat='-#,##0.00;+#,##0.00;0.00'}" Style="{StaticResource TotalValue}" />
                            <TextBlock Grid.Row="4" Text="Net cash taken" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.NetCash, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,6,0,0" />
                        </Grid>
                        <Border Height="1" Margin="0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Opening float (cash at start)" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding OpeningFloat, StringFormat=0.##, ValidatesOnExceptions=True}" TextAlignment="Right"
                                     IsEnabled="{Binding CanClose}" AutomationProperties.Name="Opening float" />
                        </Grid>
                        <Border CornerRadius="10" Background="{DynamicResource BrandSoftBrush}" Padding="14,10" Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock Text="{Binding ExpectedCash, StringFormat='₹ {0:N2}'}" DockPanel.Dock="Right" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrandBrush}" />
                                <TextBlock Text="Expected in drawer" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Count and close -->
                <Border Grid.Column="4" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="18"
                        Visibility="{Binding AllCounters, Converter={StaticResource InvertedBoolToVisibility}}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SectionHeader}" Tag="&#xE8EF;" Content="Count the drawer" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="80" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                            <TextBlock Text="NOTE / COIN" Style="{StaticResource Overline}" />
                            <TextBlock Grid.Column="1" Text="COUNT" Style="{StaticResource Overline}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="AMOUNT" Style="{StaticResource Overline}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Counts}" IsEnabled="{Binding CanClose}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="80" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat=N2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,10,0,0">
                            <TextBox DockPanel.Dock="Right" Width="140" Text="{Binding CountedCash, StringFormat=0.##, ValidatesOnExceptions=True}"
                                     TextAlignment="Right" FontWeight="SemiBold" IsEnabled="{Binding CanClose}" AutomationProperties.Name="Counted cash" />
                            <TextBlock Text="Counted cash" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </DockPanel>

                        <!-- Tally result: green when balanced, red when short, amber when over -->
                        <Border CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource ToneGreenSoft}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource ToneGreen}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DrawerStatus}" Value="Short">
                                            <Setter Property="Background" Value="{StaticResource ToneRedSoft}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource ToneRed}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DrawerStatus}" Value="Not counted yet">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DrawerStatus}" Value="Over">
                                            <Setter Property="Background" Value="{StaticResource ToneAmberSoft}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource ToneAmber}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Difference, StringFormat='+0.00;-0.00;0.00'}" FontSize="20" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DrawerStatus}" Value="Not counted yet">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DrawerStatus}" FontWeight="SemiBold" />
                                    <TextBlock Text="Counted minus expected" FontSize="11.5" Opacity="0.8" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Note (explain any difference)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Note}" IsEnabled="{Binding CanClose}" AutomationProperties.Name="Note" />
                        <Button Margin="0,14,0,0" HorizontalAlignment="Stretch" Padding="0,11" FontWeight="SemiBold"
                                Style="{DynamicResource AccentButtonStyle}" Command="{Binding CloseCounterCommand}" AutomationProperties.Name="Close my counter">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="Close my counter" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="This counter is closed for the day." Foreground="{StaticResource ToneGreen}"
                                   FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"
                                   Visibility="{Binding IsClosed, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- History -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <ContentControl Style="{StaticResource SectionHeader}" Tag="&#xE81C;" Content="Recent closings" />
                    <Grid>
                        <DataGrid x:Name="ClosingsGrid" ItemsSource="{Binding Closings}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  CanUserAddRows="False" MaxHeight="300" MinHeight="80">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Day" Binding="{Binding Date, StringFormat=dd-MM-yyyy}" Width="100" />
                                <DataGridTextColumn Header="Cashier" Binding="{Binding UserName}" Width="*" />
                                <DataGridTextColumn Header="Closed at" Binding="{Binding ClosedAt, StringFormat=dd-MM HH:mm}" Width="100" />
                                <DataGridTextColumn Header="Bills" Binding="{Binding Bills}" Width="60" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Sales" Binding="{Binding SalesTotal, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedCash, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Counted" Binding="{Binding CountedCash, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Difference" Binding="{Binding Difference, StringFormat='+0.00;-0.00;0.00'}" Width="100" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No counters closed yet." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,40,0,0"
                                   Visibility="{Binding HasItems, ElementName=ClosingsGrid, Converter={StaticResource InvertedBoolToVisibility}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
