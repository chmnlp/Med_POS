<Window x:Class="BillKro.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BillKro Rx" Width="1280" Height="800" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <CollectionViewSource x:Key="NavGroups" Source="{Binding Navigation}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: always dark teal so the brand reads the same in light and dark mode -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="14,18,14,14">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource LogoBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE719;" FontSize="19" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="19" FontWeight="Bold" Foreground="{StaticResource SidebarTextBrush}">
                            <Run Text="BillKro" /><Run Text=" Rx" Foreground="{StaticResource SidebarAccentBrush}" />
                        </TextBlock>
                        <TextBlock Text="Pharmacy &amp; retail counter" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Signed-in user -->
                <Border DockPanel.Dock="Bottom" CornerRadius="12" Background="{StaticResource SidebarHoverBrush}" Padding="10" Margin="0,10,0,0">
                    <DockPanel>
                        <Border Style="{StaticResource Avatar}" DockPanel.Dock="Left">
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SidebarIconButton}" Content="&#xE72E;" ToolTip="Change password"
                                    AutomationProperties.Name="Change password" Command="{Binding ChangePasswordCommand}" />
                            <Button Style="{StaticResource SidebarIconButton}" Content="&#xE7E8;" ToolTip="Sign out"
                                    AutomationProperties.Name="Sign out" Command="{Binding SignOutCommand}" />
                        </StackPanel>
                        <StackPanel Margin="10,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" Foreground="{StaticResource SidebarTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Navigation, grouped -->
                <ListBox x:Name="NavList" ItemsSource="{Binding Source={StaticResource NavGroups}}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource NavItemContainer}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name, Converter={StaticResource UpperCase}}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource SidebarMutedBrush}" Margin="14,14,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" FontSize="10" FontWeight="Normal"
                                           Foreground="{StaticResource SidebarMutedBrush}" VerticalAlignment="Center" Opacity="0.75" />
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,14,0" />
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page -->
        <DockPanel Grid.Column="1" Margin="32,18,32,20">
            <!-- Header: title + what the page is for, then quick jump, clock and theme -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="QuickJumpButton" Command="{Binding OpenQuickJumpCommand}" Padding="12,7" MinWidth="230"
                            HorizontalContentAlignment="Stretch" AutomationProperties.Name="Go to page" ToolTip="Jump to any page">
                        <DockPanel>
                            <ContentControl DockPanel.Dock="Right" Style="{StaticResource Keycap}" Content="Ctrl+K" Margin="16,0,0,0" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Go to page…" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                    <Border Width="1" Height="24" Margin="16,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="14" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding ClockText}" Style="{StaticResource Muted}" Margin="0,0,10,0" />
                    <Button AutomationProperties.Name="Light / dark theme" ToolTip="Switch light / dark theme"
                            Command="{Binding ToggleThemeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostIconButton}">
                                <Setter Property="Content" Value="&#xE708;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDark}" Value="True">
                                        <Setter Property="Content" Value="&#xE706;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource IconBadge}" Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding SelectedNav.Glyph}" FontSize="18"
                                   Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}" FontSize="22" />
                        <TextBlock Text="{Binding SelectedNav.Description}" Style="{StaticResource Muted}" FontSize="12.5" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
        </DockPanel>

        <!-- Quick jump (Ctrl+K) -->
        <Popup x:Name="QuickJump" Grid.Column="1" IsOpen="{Binding IsQuickJumpOpen}" StaysOpen="False" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=QuickJumpButton}" Placement="Bottom" HorizontalOffset="-180" VerticalOffset="8"
               Opened="OnQuickJumpOpened" PopupAnimation="Fade">
            <Border Style="{StaticResource RaisedCard}" Width="420" Padding="8" Margin="12">
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="QuickJumpBox" Text="{Binding QuickJumpText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="34,8,8,8" PreviewKeyDown="OnQuickJumpKeyDown" />
                        <TextBlock Style="{StaticResource SearchGlyph}" />
                    </Grid>
                    <ListBox x:Name="QuickJumpList" ItemsSource="{Binding QuickJumpResults}" SelectedItem="{Binding QuickJumpSelected}"
                             MaxHeight="340" Margin="0,6,0,0" BorderThickness="0" Background="Transparent"
                             MouseUp="OnQuickJumpClicked">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <ContentControl DockPanel.Dock="Right" Style="{StaticResource Keycap}" Content="{Binding Shortcut}"
                                                    Visibility="{Binding Shortcut, Converter={StaticResource HasValueToVisibility}}" />
                                    <Border Style="{StaticResource IconBadge}" Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14"
                                                   Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="6,8,0,2">
                        <ContentControl Style="{StaticResource ShortcutHint}" Content="↑↓" Tag="choose" />
                        <ContentControl Style="{StaticResource ShortcutHint}" Content="Enter" Tag="open" />
                        <ContentControl Style="{StaticResource ShortcutHint}" Content="Esc" Tag="close" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
