<UserControl x:Class="BillKro.Desktop.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Customer -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid Visibility="{Binding Customer, Converter={StaticResource NoValueToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="CustomerBox" Text="{Binding CustomerQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="36,6,10,6" PreviewKeyDown="OnCustomerBoxKeyDown" AutomationProperties.Name="Find customer" />
                            <TextBlock Style="{StaticResource SearchGlyph}" Text="&#xE716;" />
                            <TextBlock Text="Find customer by name or phone (F6) — blank for walk-in" Style="{StaticResource Muted}"
                                       Margin="38,0,12,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Text, ElementName=CustomerBox, Converter={StaticResource NoValueToVisibility}}" />
                            <Popup IsOpen="{Binding IsCustomerSearchOpen}" PlacementTarget="{Binding ElementName=CustomerBox}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                   Width="{Binding ActualWidth, ElementName=CustomerBox}">
                                <Border Style="{StaticResource Card}" Padding="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                                    <ListBox ItemsSource="{Binding CustomerResults}" SelectedItem="{Binding SelectedCustomerResult}"
                                             MaxHeight="300" PreviewMouseLeftButtonUp="OnCustomerPicked" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                                        <Run Text="{Binding Code, Mode=OneWay}" /> · <Run Text="{Binding Phone, Mode=OneWay}" /> · <Run Text="{Binding Type, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBox x:Name="WalkInNameBox" Text="{Binding WalkInName}" />
                            <TextBlock Text="Walk-in name" Style="{StaticResource Muted}" Margin="12,0" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=WalkInNameBox, Converter={StaticResource NoValueToVisibility}}" />
                        </Grid>
                        <Grid Grid.Column="4">
                            <TextBox x:Name="WalkInPhoneBox" Text="{Binding WalkInPhone}" />
                            <TextBlock Text="Mobile" Style="{StaticResource Muted}" Margin="12,0" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=WalkInPhoneBox, Converter={StaticResource NoValueToVisibility}}" />
                        </Grid>
                        <Button Grid.Column="6" Content="New customer" Tag="&#xE8FA;" ContentTemplate="{StaticResource IconContent}"
                                Command="{Binding NewCustomerCommand}" />
                    </Grid>

                    <DockPanel Visibility="{Binding Customer, Converter={StaticResource HasValueToVisibility}}">
                        <Button DockPanel.Dock="Right" Content="Change (F6)" Tag="&#xE711;" ContentTemplate="{StaticResource IconContent}"
                                Command="{Binding ClearCustomerCommand}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource IconBadge}" CornerRadius="20" DockPanel.Dock="Left" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="17" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource BrandBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Customer.Name}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CustomerSummary}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Prescription (shown when the bill has scheduled drugs) -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding ShowPrescription, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE95E;" Margin="4,0,12,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="Prescription" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Grid Width="220" Margin="0,0,8,0">
                        <TextBox x:Name="DoctorBox" Text="{Binding DoctorName}" />
                        <TextBlock Text="Doctor name" Style="{StaticResource Muted}" Margin="12,0" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=DoctorBox, Converter={StaticResource NoValueToVisibility}}" />
                    </Grid>
                    <Grid Width="220" Margin="0,0,12,0">
                        <TextBox x:Name="PatientBox" Text="{Binding PatientName}" />
                        <TextBlock Text="Patient name" Style="{StaticResource Muted}" Margin="12,0" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=PatientBox, Converter={StaticResource NoValueToVisibility}}" />
                    </Grid>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Text" Value="Schedule H drugs on bill — sell only against a prescription." />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsPrescription}" Value="True">
                                        <Setter Property="Text" Value="Required: Schedule H1/X drugs on this bill." />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Scan / search -->
            <Grid Grid.Row="2" Margin="0,12,0,12">
                <TextBox x:Name="ScanBox" Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}" FontSize="18"
                         Padding="52,12,90,12" PreviewKeyDown="OnScanBoxKeyDown" AutomationProperties.Name="Scan or search item" />
                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource BrandSoftBrush}" Margin="10,0,0,0"
                        HorizontalAlignment="Left" IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="15" HorizontalAlignment="Center"
                               Foreground="{DynamicResource BrandBrush}" />
                </Border>
                <TextBlock Text="Scan a barcode or type an item name   ·   3*code adds 3" Style="{StaticResource Muted}"
                           FontSize="16" Margin="54,0" IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=ScanBox, Converter={StaticResource NoValueToVisibility}}" />
                <ContentControl Style="{StaticResource Keycap}" Content="F3" HorizontalAlignment="Right" Margin="0,0,16,0" IsHitTestVisible="False" />
                <Popup x:Name="ItemPopup" IsOpen="{Binding IsItemSearchOpen}" PlacementTarget="{Binding ElementName=ScanBox}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       Width="{Binding ActualWidth, ElementName=ScanBox}">
                    <Border Style="{StaticResource Card}" Padding="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <ListBox x:Name="ItemList" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}"
                                 MaxHeight="380" PreviewMouseLeftButtonUp="OnItemPicked" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Code}" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Pack}" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Manufacturer}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding StockQty, StringFormat='Stock {0:0.###}'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StockQty}" Value="0">
                                                            <Setter Property="Text" Value="Out of stock" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="5" Text="{Binding Mrp, StringFormat='MRP {0:N2}'}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <!-- Messages -->
            <StackPanel Grid.Row="3">
                <Border Style="{StaticResource ErrorBanner}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                </Border>
                <Border Style="{StaticResource InfoBanner}"
                        Visibility="{Binding StatusMessage, Converter={StaticResource HasValueToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- Bill lines -->
            <Grid Grid.Row="4">
                <DataGrid x:Name="LinesGrid" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding LineNo}" Width="36" />
                        <DataGridTemplateColumn Header="Item" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" />
                                            <Border Margin="8,0,0,0" Padding="5,0" CornerRadius="3" VerticalAlignment="Center"
                                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                    Visibility="{Binding IsScheduled, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Item.Schedule, StringFormat='Sch {0}'}" FontSize="11"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                            <Run Text="{Binding Item.Pack, Mode=OneWay}" />  <Run Text="{Binding Item.Manufacturer, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Batch" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <ComboBox ItemsSource="{Binding Batches}" SelectedItem="{Binding Batch, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="BatchNo"
                                                  Visibility="{Binding CanPickBatch, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Batch.BatchNo}"
                                                   Visibility="{Binding CanPickBatch, Converter={StaticResource InvertedBoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Exp" Binding="{Binding Batch.ExpiryDate, StringFormat=MM/yy}" Width="60" />
                        <DataGridTextColumn Header="MRP" Binding="{Binding Batch.Mrp, StringFormat=N2}" Width="75" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTemplateColumn Header="Qty" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Tag="Qty" Text="{Binding Qty, StringFormat=0.###, ValidatesOnExceptions=True}" TextAlignment="Right"
                                             PreviewKeyDown="OnCellKeyDown" GotKeyboardFocus="OnCellFocus" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Rate" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Rate, StringFormat=0.00, ValidatesOnExceptions=True}" TextAlignment="Right"
                                             IsReadOnly="{Binding DataContext.CanEditRate, ElementName=Root, Converter={StaticResource InverseBool}}"
                                             PreviewKeyDown="OnCellKeyDown" GotKeyboardFocus="OnCellFocus" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Disc %" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DiscountPercent, StringFormat=0.##, ValidatesOnExceptions=True}" TextAlignment="Right"
                                             PreviewKeyDown="OnCellKeyDown" GotKeyboardFocus="OnCellFocus" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="GST %" Binding="{Binding Item.GstRate, StringFormat=0.##}" Width="60" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="In stock" Binding="{Binding Available, StringFormat=0.###}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverStock}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" Padding="6,4"
                                            ToolTip="Remove line (Del)" Click="OnRemoveLine" Focusable="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,40,0,0"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Grid Width="120" Height="120" HorizontalAlignment="Center">
                        <Ellipse Fill="{DynamicResource BrandSoftBrush}" />
                        <Ellipse Margin="18" Fill="{DynamicResource BrandSoftBrush}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BF;" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource BrandBrush}" />
                    </Grid>
                    <TextBlock Text="Ready for the next customer" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,4" />
                    <TextBlock Text="Scan a barcode or type a few letters of the item name" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <ContentControl Style="{StaticResource ShortcutHint}" Content="F6" Tag="pick customer" />
                        <ContentControl Style="{StaticResource ShortcutHint}" Content="F9" Tag="resume a held bill" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Shortcut strip -->
            <WrapPanel Grid.Row="5" Margin="0,12,0,0">
                <ContentControl Style="{StaticResource ShortcutHint}" Content="F2" Tag="New bill" />
                <ContentControl Style="{StaticResource ShortcutHint}" Content="F3" Tag="Item" />
                <ContentControl Style="{StaticResource ShortcutHint}" Content="F4" Tag="Qty" />
                <ContentControl Style="{StaticResource ShortcutHint}" Content="F6" Tag="Customer" />
                <ContentControl Style="{StaticResource ShortcutHint}" Content="F8" Tag="Hold" />
                <ContentControl Style="{StaticResource ShortcutHint}" Content="F9" Tag="Resume" />
                <ContentControl Style="{StaticResource ShortcutHint}" Content="F12" Tag="Pay" />
                <ContentControl Style="{StaticResource ShortcutHint}" Content="Del" Tag="Remove line" />
                <ContentControl Style="{StaticResource ShortcutHint}" Content="Enter" Tag="in a cell returns to scanning" />
            </WrapPanel>
        </Grid>

        <!-- Totals: receipt-style summary with the amount due on a brand card -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <!-- Amount due -->
                    <Border CornerRadius="14" Background="{DynamicResource BrandHeroBrush}" Padding="18,14" Margin="0,0,0,12"
                            Effect="{StaticResource GlowShadow}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Foreground="#CCFFFFFF" FontSize="12" VerticalAlignment="Center">
                                    <Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=" item(s)" />
                                </TextBlock>
                                <TextBlock Text="AMOUNT DUE" Foreground="#CCFFFFFF" FontSize="11" FontWeight="SemiBold" />
                            </DockPanel>
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Totals.Total, StringFormat='₹ {0:N2}'}" FontSize="40" FontWeight="Bold" Foreground="White" />
                            </Viewbox>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding PayCommand}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Pay" Padding="0,13" FontSize="17" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" FontSize="18" Margin="0,0,10,0" />
                            <TextBlock Text="Collect payment" VerticalAlignment="Center" />
                            <Border CornerRadius="5" Background="#33FFFFFF" Padding="6,1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="F12" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <Button Command="{Binding HoldCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" Padding="0,7" AutomationProperties.Name="Hold">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" HorizontalAlignment="Center" />
                                <TextBlock Text="Hold · F8" FontSize="11.5" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RecallCommand}" HorizontalAlignment="Stretch" Margin="2,0" Padding="0,7" AutomationProperties.Name="Resume">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" HorizontalAlignment="Center" />
                                <TextBlock Text="Resume · F9" FontSize="11.5" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NewBillCommand}" HorizontalAlignment="Stretch" Margin="4,0,0,0" Padding="0,7" AutomationProperties.Name="New">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" HorizontalAlignment="Center" />
                                <TextBlock Text="New · F2" FontSize="11.5" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                            <TextBlock Foreground="{DynamicResource BrandBrush}" FontSize="11.5" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="CGST + SGST" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInterState}" Value="True">
                                                <Setter Property="Text" Value="IGST · inter-state" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="Bill summary" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Items" Style="{StaticResource TotalLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ItemCount}" Style="{StaticResource TotalValue}" />
                        <TextBlock Grid.Row="1" Text="Gross" Style="{StaticResource TotalLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Totals.Gross, StringFormat=N2}" Style="{StaticResource TotalValue}" />
                        <TextBlock Grid.Row="2" Text="Discount" Style="{StaticResource TotalLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Totals.Discount, StringFormat='-#,##0.00;+#,##0.00;0.00'}" Style="{StaticResource TotalValue}" />
                        <TextBlock Grid.Row="3" Text="Taxable value" Style="{StaticResource TotalLabel}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Totals.Taxable, StringFormat=N2}" Style="{StaticResource TotalValue}" />

                        <TextBlock Grid.Row="4" Text="CGST" Style="{StaticResource TotalLabel}"
                                   Visibility="{Binding IsInterState, Converter={StaticResource InvertedBoolToVisibility}}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Totals.Cgst, StringFormat=N2}" Style="{StaticResource TotalValue}"
                                   Visibility="{Binding IsInterState, Converter={StaticResource InvertedBoolToVisibility}}" />
                        <TextBlock Grid.Row="5" Text="SGST" Style="{StaticResource TotalLabel}"
                                   Visibility="{Binding IsInterState, Converter={StaticResource InvertedBoolToVisibility}}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Totals.Sgst, StringFormat=N2}" Style="{StaticResource TotalValue}"
                                   Visibility="{Binding IsInterState, Converter={StaticResource InvertedBoolToVisibility}}" />
                        <TextBlock Grid.Row="4" Text="IGST (inter-state)" Style="{StaticResource TotalLabel}"
                                   Visibility="{Binding IsInterState, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Totals.Igst, StringFormat=N2}" Style="{StaticResource TotalValue}"
                                   Visibility="{Binding IsInterState, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Grid.Row="6" Text="Round off" Style="{StaticResource TotalLabel}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Totals.RoundOff, StringFormat=+0.00;-0.00;0.00}" Style="{StaticResource TotalValue}" />
                    </Grid>
                    <!-- Receipt tear line -->
                    <Border Height="1.5" Margin="0,12,0,0" ClipToBounds="True">
                        <Line X1="0" X2="2000" Stroke="{DynamicResource DividerStrokeColorDefaultBrush}" StrokeThickness="1.5" StrokeDashArray="4 3" />
                    </Border>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
