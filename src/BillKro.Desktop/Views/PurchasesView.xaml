<UserControl x:Class="BillKro.Desktop.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BillKro.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Receive goods" Tag="&#xE710;" ContentTemplate="{StaticResource IconContent}"
                        Style="{DynamicResource AccentButtonStyle}" Command="{Binding NewCommand}" ToolTip="F2 — manual entry or EDE file import" />
                <Button Content="View" Tag="&#xE8A1;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0" Command="{Binding ViewCommand}" ToolTip="Enter" />
                <Button Content="Print labels" Tag="&#xE8EC;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0"
                        Command="{Binding PrintLabelsCommand}" ToolTip="Barcode stickers for the stock received on this purchase" />
                <Button Content="Return to supplier" Tag="&#xE7A7;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0"
                        Command="{Binding ReturnToSupplierCommand}" ToolTip="Debit note against this purchase" />
                <Button Content="Cancel purchase" Tag="&#xE711;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
                <Button Content="Refresh" Tag="&#xE72C;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0" Command="{Binding RefreshCommand}" ToolTip="F5" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Grid Width="300">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,10,6" AutomationProperties.Name="Search" />
                    <TextBlock Style="{StaticResource SearchGlyph}" />
                    <TextBlock Text="Purchase no., supplier or invoice no.  (Ctrl+F)" Style="{StaticResource Muted}"
                               Margin="36,0,12,0" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NoValueToVisibility}}" />
                </Grid>
                <TextBlock Text="From" Style="{StaticResource Muted}" Margin="16,0,8,0" />
                <DatePicker SelectedDate="{Binding FromDate}" Width="140" />
                <TextBlock Text="To" Style="{StaticResource Muted}" Margin="12,0,8,0" />
                <DatePicker SelectedDate="{Binding ToDate}" Width="140" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource ErrorBanner}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
        </Border>

        <DataGrid Grid.Row="2" x:Name="ListGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Purchase no." Binding="{Binding PurchaseNo}" Width="140" />
                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAt, StringFormat=dd-MM-yyyy HH:mm}" Width="140" />
                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="2*" />
                <DataGridTextColumn Header="Supplier inv." Binding="{Binding SupplierInvoiceNo}" Width="*" />
                <DataGridTextColumn Header="Inv. date" Binding="{Binding SupplierInvoiceDate, StringFormat=dd-MM-yyyy}" Width="100" />
                <DataGridTextColumn Header="Lines" Binding="{Binding LineCount}" Width="60" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Total, StringFormat=N2}" Width="120" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTemplateColumn Header="Status" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="4,0" VerticalAlignment="Center">
                                <Border x:Name="Ok" Style="{StaticResource ChipGreen}"><TextBlock Text="Received" /></Border>
                                <Border x:Name="Cancelled" Style="{StaticResource ChipRed}" Visibility="Collapsed"><TextBlock Text="Cancelled" /></Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                    <Setter TargetName="Ok" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Cancelled" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <views:EmptyState Grid.Row="2" Glyph="&#xE7B8;" Title="No purchases in this period" Hint="Enter a supplier bill or import an EDE file to receive stock." Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="0,0,16,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
            <Button Tag="&#xE76B;" ContentTemplate="{StaticResource IconContent}" Content="Previous" Command="{Binding PreviousPageCommand}" />
            <Button Tag="&#xE76C;" ContentTemplate="{StaticResource IconContent}" Content="Next" Margin="8,0,0,0" Command="{Binding NextPageCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
