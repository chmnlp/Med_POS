<UserControl x:Class="BillKro.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BillKro.Desktop.ViewModels">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource ErrorBanner}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,-36">
            <Button Content="Refresh" Tag="&#xE72C;" ContentTemplate="{StaticResource IconContent}" Command="{Binding RefreshCommand}" />
            <Button Content="Export to Excel (CSV)" Tag="&#xE78C;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0"
                    Command="{Binding ExportCommand}" />
        </StackPanel>

        <TabControl SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Expiry">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Expiring within" Style="{StaticResource Muted}" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{x:Static vm:ReportsViewModel.ExpiryWindows}" SelectedItem="{Binding ExpiryDays}" Width="90" />
                        <TextBlock Text="days" Style="{StaticResource Muted}" Margin="8,0,16,0" />
                        <CheckBox Content="Include already expired" IsChecked="{Binding IncludeExpired}" />
                        <TextBlock Text="{Binding ExpirySummary}" Style="{StaticResource Muted}" Margin="24,0,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ExpiryRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="2*" />
                            <DataGridTextColumn Header="Company" Binding="{Binding Manufacturer}" Width="*" />
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="100" />
                            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=dd-MM-yyyy}" Width="100" ElementStyle="{StaticResource ExpiryCell}" />
                            <DataGridTextColumn Header="Days left" Binding="{Binding DaysLeft}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ExpiryCell}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty, StringFormat=0.###}" Width="70" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Cost" Binding="{Binding PurchaseRate, StringFormat=N2}" Width="80" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}" Width="80" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Value at cost" Binding="{Binding PurchaseValue, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumberCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Reorder">
                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ReorderSummary}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding ReorderRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding ItemCode}" Width="90" />
                            <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="2*" />
                            <DataGridTextColumn Header="Company" Binding="{Binding Manufacturer}" Width="*" />
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat=0.###}" Width="80" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Reorder at" Binding="{Binding ReorderLevel, StringFormat=0.###}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Order qty" Binding="{Binding SuggestedQty, StringFormat=0.###}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Last supplier" Binding="{Binding LastSupplier}" Width="*" />
                            <DataGridTextColumn Header="Last rate" Binding="{Binding LastPurchaseRate, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Stock valuation">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Grid Width="300">
                            <TextBox x:Name="ValuationSearch" Text="{Binding ValuationSearch}" KeyDown="OnValuationSearchKey" />
                            <TextBlock Text="Filter by item or company, then Enter" Style="{StaticResource Muted}" Margin="12,0" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=ValuationSearch, Converter={StaticResource NoValueToVisibility}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" Margin="24,0,0,0" VerticalAlignment="Center">
                            <Run Text="{Binding Valuation.Total, Mode=OneWay, StringFormat='{}{0} item(s)'}" /> ·
                            qty <Run Text="{Binding Valuation.TotalQty, Mode=OneWay, StringFormat=0.###}" /> ·
                            at cost <Run Text="{Binding Valuation.TotalPurchaseValue, Mode=OneWay, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" /> ·
                            at MRP <Run Text="{Binding Valuation.TotalMrpValue, Mode=OneWay, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ValuationRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding ItemCode}" Width="90" />
                            <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="2*" />
                            <DataGridTextColumn Header="Company" Binding="{Binding Manufacturer}" Width="*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty, StringFormat=0.###}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Value at cost" Binding="{Binding PurchaseValue, StringFormat=N2}" Width="130" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Value at MRP" Binding="{Binding MrpValue, StringFormat=N2}" Width="130" ElementStyle="{StaticResource NumberCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Profit">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="From" Style="{StaticResource Muted}" Margin="0,0,8,0" />
                        <DatePicker SelectedDate="{Binding ProfitFrom}" Width="140" />
                        <TextBlock Text="To" Style="{StaticResource Muted}" Margin="12,0,8,0" />
                        <DatePicker SelectedDate="{Binding ProfitTo}" Width="140" />
                        <TextBlock Text="By" Style="{StaticResource Muted}" Margin="16,0,8,0" />
                        <ComboBox ItemsSource="{x:Static vm:ReportsViewModel.ProfitGroupings}" SelectedItem="{Binding ProfitGrouping}" Width="100" />
                        <TextBlock Style="{StaticResource Muted}" Margin="24,0,0,0" VerticalAlignment="Center">
                            Sales <Run Text="{Binding Profit.Revenue, Mode=OneWay, StringFormat='₹ {0:N2}'}" /> ·
                            cost <Run Text="{Binding Profit.Cost, Mode=OneWay, StringFormat='₹ {0:N2}'}" /> ·
                            profit <Run Text="{Binding Profit.Profit, Mode=OneWay, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" />
                            (<Run Text="{Binding Profit.MarginPercent, Mode=OneWay, StringFormat='{}{0:0.##}%'}" />)
                        </TextBlock>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Sales are taxable value (excluding GST) after returns. Cost is each lot's landed cost recorded when the bill was made, so later purchases at a different price do not change past profit." />
                    <DataGrid ItemsSource="{Binding ProfitRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Day / item" Binding="{Binding Label}" Width="2*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty, StringFormat=0.###}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Sales (ex GST)" Binding="{Binding Revenue, StringFormat=N2}" Width="130" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=N2}" Width="120" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat=N2}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Margin %" Binding="{Binding MarginPercent, StringFormat=0.##}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
