<Window x:Class="BillKro.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BillKro Rx — Sign in" Width="880" Height="560"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SineEase x:Key="Sine" EasingMode="EaseInOut" />

        <!-- Continuous background motion on the brand panel. Started from code (skipped when Windows animations are off). -->
        <Storyboard x:Key="AmbientMotion">
            <!-- Soft glows drifting around -->
            <DoubleAnimation Storyboard.TargetName="GlowA" Storyboard.TargetProperty="X" From="-30" To="60" Duration="0:0:9"
                             AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource Sine}" />
            <DoubleAnimation Storyboard.TargetName="GlowA" Storyboard.TargetProperty="Y" From="-20" To="50" Duration="0:0:11"
                             AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource Sine}" />
            <DoubleAnimation Storyboard.TargetName="GlowB" Storyboard.TargetProperty="X" From="40" To="-50" Duration="0:0:12"
                             AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource Sine}" />
            <DoubleAnimation Storyboard.TargetName="GlowB" Storyboard.TargetProperty="Y" From="30" To="-40" Duration="0:0:10"
                             AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource Sine}" />

            <!-- Rings turning in opposite directions -->
            <DoubleAnimation Storyboard.TargetName="RingSpinA" Storyboard.TargetProperty="Angle" From="0" To="360"
                             Duration="0:1:0" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="RingSpinB" Storyboard.TargetProperty="Angle" From="360" To="0"
                             Duration="0:0:40" RepeatBehavior="Forever" />

            <!-- Floating capsules -->
            <DoubleAnimation Storyboard.TargetName="PillMoveA" Storyboard.TargetProperty="Y" From="0" To="-18" Duration="0:0:3.4"
                             AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource Sine}" />
            <DoubleAnimation Storyboard.TargetName="PillSpinA" Storyboard.TargetProperty="Angle" From="-30" To="-12" Duration="0:0:4.2"
                             AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource Sine}" />
            <DoubleAnimation Storyboard.TargetName="PillMoveB" Storyboard.TargetProperty="Y" From="0" To="14" Duration="0:0:4"
                             AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource Sine}" />
            <DoubleAnimation Storyboard.TargetName="PillSpinB" Storyboard.TargetProperty="Angle" From="40" To="62" Duration="0:0:5"
                             AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource Sine}" />
            <DoubleAnimation Storyboard.TargetName="PillMoveC" Storyboard.TargetProperty="Y" From="0" To="-12" Duration="0:0:3.8"
                             AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource Sine}" />
            <DoubleAnimation Storyboard.TargetName="PillSpinC" Storyboard.TargetProperty="Angle" From="-70" To="-50" Duration="0:0:4.6"
                             AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource Sine}" />
        </Storyboard>

        <!-- Ripple coming off the logo tile every few seconds -->
        <Storyboard x:Key="LogoPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.7"
                             BeginTime="0:0:1" Duration="0:0:1.4" EasingFunction="{StaticResource Sine}" />
            <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.7"
                             BeginTime="0:0:1" Duration="0:0:1.4" EasingFunction="{StaticResource Sine}" />
            <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity" From="0.7" To="0"
                             BeginTime="0:0:1" Duration="0:0:1.4" />
            <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity" To="0"
                             BeginTime="0:0:3.6" Duration="0:0:0" />
        </Storyboard>

        <!-- Light sweeping across "Track every batch." -->
        <Storyboard x:Key="HeadlineShine" RepeatBehavior="Forever" Duration="0:0:5">
            <DoubleAnimation Storyboard.TargetName="ShineA" Storyboard.TargetProperty="Offset" From="-0.4" To="1.0"
                             BeginTime="0:0:1.8" Duration="0:0:1.5" EasingFunction="{StaticResource Sine}" />
            <DoubleAnimation Storyboard.TargetName="ShineB" Storyboard.TargetProperty="Offset" From="-0.2" To="1.2"
                             BeginTime="0:0:1.8" Duration="0:0:1.5" EasingFunction="{StaticResource Sine}" />
            <DoubleAnimation Storyboard.TargetName="ShineC" Storyboard.TargetProperty="Offset" From="0" To="1.4"
                             BeginTime="0:0:1.8" Duration="0:0:1.5" EasingFunction="{StaticResource Sine}" />
        </Storyboard>

        <Style x:Key="Capsule" TargetType="Border">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#40FFFFFF" Offset="0" />
                        <GradientStop Color="#40FFFFFF" Offset="0.5" />
                        <GradientStop Color="#3399F6E4" Offset="0.5" />
                        <GradientStop Color="#3399F6E4" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border Grid.Column="0" Background="{DynamicResource BrandHeroBrush}" ClipToBounds="True">
            <Grid>
                <!-- Drifting glows -->
                <Ellipse Width="320" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-110,0,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#5599F6E4" Offset="0" />
                            <GradientStop Color="#0099F6E4" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="GlowA" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-140,-120"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#33FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="GlowB" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Turning rings -->
                <Ellipse Width="360" Height="360" Stroke="#1AFFFFFF" StrokeThickness="40" Margin="0,0,-170,-150"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" />
                <Ellipse Width="440" Height="440" Stroke="#33FFFFFF" StrokeThickness="2" StrokeDashArray="2 5" Margin="0,0,-210,-190"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="RingSpinA" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="170" Height="170" Stroke="#26FFFFFF" StrokeThickness="2" StrokeDashArray="4 6"
                         Margin="0,-60,-50,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                         RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="RingSpinB" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="120" Height="120" Fill="#0FFFFFFF" Margin="0,-35,-25,0"
                         HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" />

                <!-- Floating capsules -->
                <Border Style="{StaticResource Capsule}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,128,46,0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="PillSpinA" Angle="-30" />
                            <TranslateTransform x:Name="PillMoveA" />
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
                <Border Style="{StaticResource Capsule}" Width="34" Height="14" CornerRadius="7"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,120,92">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="PillSpinB" Angle="40" />
                            <TranslateTransform x:Name="PillMoveB" />
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
                <Border Style="{StaticResource Capsule}" Width="28" Height="12" CornerRadius="6" Opacity="0.8"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,40,24,0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="PillSpinC" Angle="-70" />
                            <TranslateTransform x:Name="PillMoveC" />
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>

                <DockPanel Margin="40,40,40,32">
                    <StackPanel x:Name="LogoRow" DockPanel.Dock="Top" Orientation="Horizontal">
                        <Grid>
                            <Border x:Name="PulseRing" Width="44" Height="44" CornerRadius="13" BorderBrush="#99F6E4"
                                    BorderThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="PulseScale" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="LogoTile" Width="44" Height="44" CornerRadius="13" Background="#33FFFFFF"
                                    BorderBrush="#40FFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE719;" FontSize="22" Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Run Text="BillKro" /><Run Text=" Rx" Foreground="#99F6E4" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock x:Name="Footer" DockPanel.Dock="Bottom" Text="Works alongside your ERP · your accounts stay there"
                               Foreground="#B3FFFFFF" FontSize="11.5" TextWrapping="Wrap" />

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeadLine1" Text="Bill faster." Foreground="White" FontSize="34" FontWeight="Bold" />
                        <TextBlock x:Name="HeadLine2" Text="Track every batch." FontSize="34" FontWeight="Bold" Margin="0,-4,0,22">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3">
                                    <GradientStop Color="#99F6E4" Offset="0" />
                                    <GradientStop x:Name="ShineA" Color="#99F6E4" Offset="-0.4" />
                                    <GradientStop x:Name="ShineB" Color="#FFFFFF" Offset="-0.2" />
                                    <GradientStop x:Name="ShineC" Color="#99F6E4" Offset="0" />
                                    <GradientStop Color="#99F6E4" Offset="1" />
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <StackPanel x:Name="Feature1" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#1FFFFFFF" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BF;" FontSize="14" Foreground="#99F6E4" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Barcode billing with keyboard shortcuts" Foreground="White" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="Feature2" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#1FFFFFFF" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="14" Foreground="#99F6E4" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Batch, expiry and MRP on every line" Foreground="White" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="Feature3" Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#1FFFFFFF" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="14" Foreground="#99F6E4" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Purchases flow straight into your ERP" Foreground="White" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <StackPanel x:Name="FormPanel" Grid.Column="1" VerticalAlignment="Center" Margin="56,0">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="FormShake" />
            </StackPanel.RenderTransform>

            <TextBlock Text="Welcome back" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Sign in to open your counter" Style="{StaticResource Muted}" Margin="0,4,0,20" />

            <Border x:Name="ErrorBanner" Style="{StaticResource ErrorBanner}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="14" Margin="0,0,10,0"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
            <Grid>
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="36,9,10,9"
                         AutomationProperties.Name="Username" />
                <TextBlock Style="{StaticResource SearchGlyph}" Text="&#xE77B;" />
            </Grid>

            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
            <Grid>
                <PasswordBox x:Name="PasswordBox" Padding="36,9,44,9" AutomationProperties.Name="Password" />
                <!-- Plain-text copy of the password, shown while the eye button is on -->
                <TextBox x:Name="PasswordText" Padding="36,9,44,9" Visibility="Collapsed"
                         AutomationProperties.Name="Password (visible)" TextChanged="OnPasswordTextChanged" />
                <TextBlock Style="{StaticResource SearchGlyph}" Text="&#xE72E;" />
                <Button x:Name="RevealButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                        Width="32" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                        Focusable="False" Cursor="Hand" ToolTip="Show password" AutomationProperties.Name="Show password"
                        Click="OnRevealClick">
                    <TextBlock x:Name="RevealGlyph" Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="15"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>
            </Grid>

            <Expander x:Name="ServerExpander" Margin="0,14,0,0">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" FontSize="13" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Server" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ServerUrl}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" Opacity="0.75" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="Server address (the shop's BillKro Rx server PC)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Server address" />
                </StackPanel>
            </Expander>

            <Grid Margin="0,24,0,0">
                <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top" Margin="0,-12,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Button x:Name="SignInButton" IsDefault="True" HorizontalAlignment="Stretch" Padding="0,11" FontSize="15" FontWeight="SemiBold"
                        Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="Sign in"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Click="OnSignIn" MouseEnter="OnButtonEnter" MouseLeave="OnButtonLeave">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sign in" Visibility="{Binding IsBusy, Converter={StaticResource InvertedBoolToVisibility}}" />
                        <TextBlock Text="Signing in…" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="13" Margin="10,1,0,0">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="ArrowNudge" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Text="Press Enter to sign in" Style="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</Window>
