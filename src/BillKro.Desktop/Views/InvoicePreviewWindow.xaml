<Window x:Class="BillKro.Desktop.Views.InvoicePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice preview" Width="900" Height="860" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Print" Tag="&#xE749;" ContentTemplate="{StaticResource IconContent}"
                        Style="{DynamicResource AccentButtonStyle}" Click="OnPrint" IsDefault="True" />
                <Button Content="Close" IsCancel="True" Margin="8,0,0,0" MinWidth="90" />
            </StackPanel>
        </Border>
        <!-- Paper is always white, whatever the app theme. -->
        <Border Background="#E6E6E6">
            <FlowDocumentScrollViewer x:Name="Viewer" HorizontalAlignment="Center" Margin="0,16"
                                      VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" Background="White" />
        </Border>
    </DockPanel>
</Window>
