{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Sync": {
    "SqlConnectionString": "Server=YOUR_SQL_SERVER;Database=BillKroSync;Integrated Security=True;TrustServerCertificate=True;",
    "ErpExportFolder": "\\\\ERP-PC\\ERP\\Exports",
    "ErpImportFolder": "\\\\ERP-PC\\ERP\\Method",
    "ArchiveFolder": "C:\\SyncArchive",
    "ErrorFolder": "C:\\SyncErrors",
    "PollIntervalSeconds": 300,
    "FilePatterns": "*.csv"
  }
}
