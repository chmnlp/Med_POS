<Application x:Class="MargPos.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MargPos.Desktop.ViewModels"
             xmlns:views="clr-namespace:MargPos.Desktop.Views"
             xmlns:forms="clr-namespace:MargPos.Desktop.Views.Forms"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Pages -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ItemsViewModel}"><views:ItemsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomersViewModel}"><views:CustomersView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SuppliersViewModel}"><views:SuppliersView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersViewModel}"><views:UsersView /></DataTemplate>

            <!-- Editor forms -->
            <DataTemplate DataType="{x:Type vm:ItemEditorViewModel}"><forms:ItemForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BatchEditorViewModel}"><forms:BatchForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomerEditorViewModel}"><forms:CustomerForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SupplierEditorViewModel}"><forms:SupplierForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UserEditorViewModel}"><forms:UserForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResetPasswordViewModel}"><forms:ResetPasswordForm /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
