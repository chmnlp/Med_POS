<Application x:Class="MargPos.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MargPos.Desktop.ViewModels"
             xmlns:views="clr-namespace:MargPos.Desktop.Views"
             xmlns:forms="clr-namespace:MargPos.Desktop.Views.Forms"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Pages -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ItemsViewModel}"><views:ItemsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomersViewModel}"><views:CustomersView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SuppliersViewModel}"><views:SuppliersView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersViewModel}"><views:UsersView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BillingViewModel}"><views:BillingView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SalesViewModel}"><views:SalesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PurchasesViewModel}"><views:PurchasesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PurchaseReturnsViewModel}"><views:PurchaseReturnsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountsViewModel}"><views:AccountsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MargLinkViewModel}"><views:MargLinkView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DayEndViewModel}"><views:DayEndView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SalesReportsViewModel}"><views:SalesReportsView /></DataTemplate>

            <!-- Editor forms -->
            <DataTemplate DataType="{x:Type vm:ItemEditorViewModel}"><forms:ItemForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BatchEditorViewModel}"><forms:BatchForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomerEditorViewModel}"><forms:CustomerForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SupplierEditorViewModel}"><forms:SupplierForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UserEditorViewModel}"><forms:UserForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResetPasswordViewModel}"><forms:ResetPasswordForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PaymentViewModel}"><forms:PaymentForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HeldBillsViewModel}"><forms:HeldBillsForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SaleReturnViewModel}"><forms:SaleReturnForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CancelSaleViewModel}"><forms:CancelSaleForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PurchaseEditorViewModel}"><forms:PurchaseForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PurchaseDetailViewModel}"><forms:PurchaseDetailForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReasonViewModel}"><forms:ReasonForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StockAdjustViewModel}"><forms:StockAdjustForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StockHistoryViewModel}"><forms:StockHistoryForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PurchaseReturnEditorViewModel}"><forms:PurchaseReturnForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReceiptEditorViewModel}"><forms:MoneyForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SupplierPaymentEditorViewModel}"><forms:MoneyForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatementViewModel}"><forms:StatementForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CreditNotePickerViewModel}"><forms:CreditNotePickerForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LabelPrintViewModel}"><forms:LabelPrintForm /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BarcodeSetupViewModel}"><forms:BarcodeSetupForm /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
