<UserControl x:Class="MargPos.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style x:Key="TileGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,8">
            <Border Style="{StaticResource ErrorBanner}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <!-- Hero: greeting + today's takings -->
            <Border CornerRadius="16" Background="{DynamicResource BrandHeroBrush}" ClipToBounds="True" Margin="0,0,14,18"
                    Effect="{StaticResource GlowShadow}">
                <Grid>
                    <Ellipse Width="300" Height="300" Stroke="#14FFFFFF" StrokeThickness="34" Margin="0,-120,-60,0"
                             HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <Ellipse Width="120" Height="120" Fill="#0DFFFFFF" Margin="0,0,260,-60"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    <Grid Margin="28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Foreground="White" FontSize="26" FontWeight="SemiBold">
                                <Run Text="{Binding Greeting, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding FirstName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding TodayText}" Foreground="#CCFFFFFF" Margin="0,4,0,18" />
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding GoBillingCommand}" Padding="18,9" Cursor="Hand" AutomationProperties.Name="Start billing"
                                        Background="White" Foreground="#0F766E" BorderThickness="0" FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BF;" FontSize="15" Margin="0,0,10,0" />
                                        <TextBlock Text="Start billing" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="or press Ctrl+1 from anywhere" Foreground="#B3FFFFFF" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" CornerRadius="14" Background="#1FFFFFFF" Padding="22,16" Width="320" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="TODAY'S SALES" Foreground="#CCFFFFFF" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary.TodaySales, StringFormat='₹ {0:N0}', FallbackValue='₹ –'}" Foreground="White"
                                           FontSize="38" FontWeight="Bold" Margin="0,2,0,6" />
                                <ProgressBar Height="5" Maximum="1" Value="{Binding TodayShareOfMonth, Mode=OneWay}" Foreground="#99F6E4"
                                             Background="#26FFFFFF" BorderThickness="0" ToolTip="Today's share of this month's sales" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Foreground="#E6FFFFFF" FontSize="12.5">
                                        <Run Text="{Binding Summary.TodayBills, Mode=OneWay, FallbackValue=0}" FontWeight="SemiBold" /><Run Text=" bills" />
                                    </TextBlock>
                                    <TextBlock Foreground="#E6FFFFFF" FontSize="12.5" Margin="16,0,0,0"
                                               Visibility="{Binding AverageBill, Converter={StaticResource HasValueToVisibility}}">
                                        <Run Text="avg " /><Run Text="{Binding AverageBill, Mode=OneWay, StringFormat='₹ {0:N0}'}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- KPI tiles -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}" Background="{StaticResource ToneBlueSoft}" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE787;" Foreground="{StaticResource ToneBlue}" />
                        </Border>
                        <TextBlock Text="THIS MONTH" Style="{StaticResource Overline}" />
                        <TextBlock Text="{Binding Summary.MonthSales, StringFormat='₹ {0:N0}', FallbackValue=–}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Sales after returns" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}" Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}" Background="{StaticResource ToneGreenSoft}" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE9D2;" Foreground="{StaticResource ToneGreen}" />
                        </Border>
                        <TextBlock Text="GROSS PROFIT TODAY" Style="{StaticResource Overline}" />
                        <TextBlock Text="{Binding Summary.TodayProfit, StringFormat='₹ {0:N0}', FallbackValue=–}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource ToneGreen}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12">
                            <Run Text="{Binding Summary.MonthProfit, Mode=OneWay, StringFormat='₹ {0:N0} this month'}" />
                            <Run Text="{Binding MonthMarginPercent, Mode=OneWay, StringFormat='· {0}% margin'}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}" Background="{StaticResource ToneRedSoft}" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE8C7;" Foreground="{StaticResource ToneRed}" />
                        </Border>
                        <TextBlock Text="OVERDUE FROM CUSTOMERS" Style="{StaticResource Overline}" />
                        <TextBlock Text="{Binding Summary.OverdueAmount, StringFormat='₹ {0:N0}', FallbackValue=–}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding Summary.OverdueCustomers, StringFormat='{}{0} customer(s) past credit days'}" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <Border Style="{StaticResource IconBadge}" Background="{StaticResource TonePurpleSoft}" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE719;" Foreground="{StaticResource TonePurple}" />
                        </Border>
                        <TextBlock Text="CATALOGUE" Style="{StaticResource Overline}" />
                        <TextBlock Text="{Binding Summary.ActiveItems, StringFormat='{}{0:N0} items', FallbackValue=–}" Style="{StaticResource StatValue}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12">
                            <Run Text="{Binding Summary.Customers, Mode=OneWay, StringFormat='{}{0:N0} customers'}" /><Run Text=" · " /><Run Text="{Binding Summary.Suppliers, Mode=OneWay, StringFormat='{}{0:N0} suppliers'}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Attention + quick actions -->
            <Grid Margin="0,4,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" Margin="0,0,10,0" Foreground="{DynamicResource BrandBrush}" />
                            <TextBlock Text="Needs attention" Style="{StaticResource SectionTitle}" Margin="0" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Attention}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding Open}" Style="{StaticResource ActionTile}" Margin="0,0,0,8"
                                            AutomationProperties.Name="{Binding Title}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Border x:Name="Badge" Style="{StaticResource IconBadge}" Width="36" Height="36" Margin="0,0,14,0"
                                                    Background="{StaticResource ToneAmberSoft}">
                                                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="15"
                                                           HorizontalAlignment="Center" Foreground="{StaticResource ToneAmber}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="Critical">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource ToneRedSoft}" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource ToneRed}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,6"
                                    Visibility="{Binding AllClear, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource IconBadge}" Background="{StaticResource ToneGreenSoft}" Margin="0,0,14,0">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE73E;" Foreground="{StaticResource ToneGreen}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="All clear" FontWeight="SemiBold" />
                                <TextBlock Text="No overdue customers, no stock running low, nothing about to expire." Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <!-- First-run tips while the catalogue is empty -->
                        <Border CornerRadius="10" Background="{DynamicResource BrandSoftBrush}" Padding="14,12" Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Summary.ActiveItems}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock TextWrapping="Wrap" LineHeight="22">
                                <Bold>Getting started</Bold><LineBreak />
                                1. Add your suppliers under <Bold>Suppliers</Bold>.<LineBreak />
                                2. Add items under <Bold>Items &amp; Stock</Bold> — tick <Italic>Batch tracked</Italic> for medicines, then add each batch.<LineBreak />
                                3. Add cashier and manager accounts under <Bold>Users</Bold> (admins only).
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Margin="0,0,10,0" Foreground="{DynamicResource BrandBrush}" />
                            <TextBlock Text="Quick actions" Style="{StaticResource SectionTitle}" Margin="0" />
                        </DockPanel>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource ActionTile}" Margin="0,0,6,8" Command="{Binding GoBillingCommand}" AutomationProperties.Name="New bill">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BF;" FontSize="20" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Left" />
                                    <TextBlock Text="New bill" FontWeight="SemiBold" Margin="0,10,0,0" />
                                    <TextBlock Text="Scan and sell" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Margin="6,0,0,8" Command="{Binding GoAccountsCommand}" AutomationProperties.Name="Receive payment">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" FontSize="20" Foreground="{StaticResource ToneBlue}" HorizontalAlignment="Left" />
                                    <TextBlock Text="Receive payment" FontWeight="SemiBold" Margin="0,10,0,0" />
                                    <TextBlock Text="Credit customers" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Margin="0,0,6,8" Command="{Binding GoPurchasesCommand}" AutomationProperties.Name="New purchase"
                                    Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="20" Foreground="{StaticResource TonePurple}" HorizontalAlignment="Left" />
                                    <TextBlock Text="New purchase" FontWeight="SemiBold" Margin="0,10,0,0" />
                                    <TextBlock Text="Bill or EDE import" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Margin="0,0,6,8" Command="{Binding GoItemsCommand}" AutomationProperties.Name="Find stock"
                                    Visibility="{Binding CanManage, Converter={StaticResource InvertedBoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE719;" FontSize="20" Foreground="{StaticResource TonePurple}" HorizontalAlignment="Left" />
                                    <TextBlock Text="Find stock" FontWeight="SemiBold" Margin="0,10,0,0" />
                                    <TextBlock Text="Items and batches" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTile}" Margin="6,0,0,8" Command="{Binding GoDayEndCommand}" AutomationProperties.Name="Close the day">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="20" Foreground="{StaticResource ToneAmber}" HorizontalAlignment="Left" />
                                    <TextBlock Text="Close the day" FontWeight="SemiBold" Margin="0,10,0,0" />
                                    <TextBlock Text="Count cash, print slip" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
