<UserControl x:Class="MargPos.Desktop.Views.MargLinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MargPos.Desktop.ViewModels">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource ErrorBanner}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>
            <Border Style="{StaticResource InfoBanner}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource HasValueToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,-36">
            <Button Content="Refresh" Tag="&#xE72C;" ContentTemplate="{StaticResource IconContent}" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <TabControl>
            <!-- Purchases go to MARG -->
            <TabItem Header="Purchases to MARG">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Send now" Tag="&#xE724;" ContentTemplate="{StaticResource IconContent}"
                                Style="{DynamicResource AccentButtonStyle}" Command="{Binding SendNowCommand}" />
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PendingText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LastRunText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Each purchase is written once as an EDE file into MARG's Method folder. In MARG, import it from the purchase screen (EDE / distributor file import)." />

                    <!-- Admin settings -->
                    <Border DockPanel.Dock="Right" Style="{StaticResource Card}" Width="380" Margin="16,0,0,0" VerticalAlignment="Top"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource SectionHeader}" Tag="&#xE713;" Content="Link settings" />
                            <CheckBox Content="Send purchases to MARG automatically" IsChecked="{Binding Enabled}" />
                            <TextBlock Text="MARG Method folder (as seen from the server PC)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MethodFolder}" ToolTip="e.g. \\MARG-PC\MARGERP\Method" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Test folder" Command="{Binding TestFolderCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding FolderCheck}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding FolderCheck, Converter={StaticResource HasValueToVisibility}}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Company code in file" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CompanyCode}" MaxLength="20" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Check every (minutes)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding PollMinutes, ValidatesOnExceptions=True}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Send purchases received from" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding SendFrom}" />
                            <TextBlock Text="Pick the day you start using the POS for purchases, so bills already in MARG are not sent again."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Button Content="Save settings" Margin="0,16,0,0" HorizontalAlignment="Left"
                                    Style="{DynamicResource AccentButtonStyle}" Command="{Binding SaveSettingsCommand}" />
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Exports}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Purchase" Binding="{Binding DocumentNo}" Width="130" />
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="80" />
                            <DataGridTextColumn Header="When" Binding="{Binding CreatedAt, StringFormat=dd-MM-yyyy HH:mm}" Width="130" />
                            <DataGridCheckBoxColumn Header="Cancelled later" Binding="{Binding CancelledAfterSend}" Width="125" />
                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Things to key into MARG -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="{Binding ManualTasks.Count, StringFormat='Enter in MARG ({0})'}" />
                </TabItem.Header>
                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="MARG cannot import these from a file. Enter each one in MARG, then mark it done." />
                    <DataGrid ItemsSource="{Binding ManualTasks}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Document" Binding="{Binding DocumentNo}" Width="130" />
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy}" Width="100" />
                            <DataGridTextColumn Header="Supplier" Binding="{Binding Party}" Width="*" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="100" ElementStyle="{StaticResource NumberCell}" />
                            <DataGridTextColumn Header="What to do" Binding="{Binding Action}" Width="2*" />
                            <DataGridTemplateColumn Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Mark done" Padding="8,2"
                                                Command="{Binding DataContext.MarkDoneCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Sales register -->
            <TabItem Header="Sales to MARG">
                <StackPanel Margin="0,12,0,0" HorizontalAlignment="Left" MaxWidth="760">
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="MARG has no file import for sales, so the POS gives a sales register (one row per item sold, cancelled bills left out) to enter or check against MARG. Opens in Excel." />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="From" Style="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <DatePicker SelectedDate="{Binding RegisterFrom}" Width="140" />
                        <TextBlock Text="To" Style="{StaticResource Muted}" Margin="12,0,8,0" VerticalAlignment="Center" />
                        <DatePicker SelectedDate="{Binding RegisterTo}" Width="140" />
                        <Button Content="Export sales register (CSV)" Tag="&#xE78C;" ContentTemplate="{StaticResource IconContent}" Margin="16,0,0,0"
                                Command="{Binding ExportSalesRegisterCommand}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Masters from MARG -->
            <TabItem Header="Import masters from MARG">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Export masters from MARG (C/H/T file, e.g. margdemo.csv), then choose it here. New items get MARG's stock as opening stock. Items already in the POS only get names and prices refreshed — their stock is never changed." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Choose file and preview" Tag="&#xE8E5;" ContentTemplate="{StaticResource IconContent}"
                                    Command="{Binding ChooseMasterFileCommand}" />
                            <TextBlock Text="{Binding MasterFile}" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                    Visibility="{Binding MasterPreview, Converter={StaticResource HasValueToVisibility}}">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{Binding MasterPreview.CompanyName, Mode=OneWay}" FontWeight="SemiBold" /> ·
                                <Run Text="{Binding MasterPreview.Items.Count, Mode=OneWay, StringFormat='{}{0} item row(s)'}" />,
                                <Run Text="{Binding MasterPreview.NewItems, Mode=OneWay, StringFormat='{}{0} new'}" /> ·
                                <Run Text="{Binding MasterPreview.Parties.Count, Mode=OneWay, StringFormat='{}{0} part(ies)'}" />
                            </TextBlock>
                            <TextBlock Text="Import parties as" Style="{StaticResource Muted}" Margin="24,0,8,0" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{x:Static vm:MargLinkViewModel.PartyImports}" SelectedItem="{Binding PartyImport}" Width="120" />
                            <TextBlock Text="only type" Style="{StaticResource Muted}" Margin="12,0,8,0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding PartyTypeFilter}" Width="50" MaxLength="3" CharacterCasing="Upper"
                                     ToolTip="Leave blank for all, or enter MARG's party type (the Type column), e.g. C" />
                            <Button Content="Import" Margin="16,0,0,0" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ApplyMasterCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding PreviewItems}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" />
                                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="80" />
                                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=dd-MM-yyyy}" Width="90" />
                                <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}" Width="70" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Cost" Binding="{Binding PurchaseRate, StringFormat=N2}" Width="70" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="GST %" Binding="{Binding GstRate, StringFormat=0.##}" Width="60" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Stock" Binding="{Binding OpeningQty, StringFormat=0.###}" Width="70" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridCheckBoxColumn Header="In POS" Binding="{Binding Exists}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Column="2" ItemsSource="{Binding PreviewParties}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Party" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="50" />
                                <DataGridTextColumn Header="Opening" Binding="{Binding OpeningBalance, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridCheckBoxColumn Header="Customer" Binding="{Binding ExistsAsCustomer}" Width="85" />
                                <DataGridCheckBoxColumn Header="Supplier" Binding="{Binding ExistsAsSupplier}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
