<Window x:Class="MargPos.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MargPOS — Sign in" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="32,28,32,28">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE719;" FontSize="28" Margin="0,0,12,0"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="MargPOS" FontSize="28" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock Text="Sign in to start billing" Style="{StaticResource Muted}" Margin="0,0,0,16" />

        <Border Style="{StaticResource ErrorBanner}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
        </Border>

        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordBox" />

        <Expander x:Name="ServerExpander" Header="Server" Margin="0,16,0,0">
            <StackPanel Margin="0,4,0,0">
                <TextBlock Text="Server address (the shop's MargPOS server PC)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Expander>

        <Grid Margin="0,24,0,0">
            <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top" Margin="0,-12,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Sign in" IsDefault="True" HorizontalAlignment="Stretch" Padding="0,8"
                    Style="{DynamicResource AccentButtonStyle}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Click="OnSignIn" />
        </Grid>
    </StackPanel>
</Window>
