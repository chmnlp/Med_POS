<Window x:Class="MargPos.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MargPOS — Sign in" Width="880" Height="560"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border Grid.Column="0" Background="{DynamicResource BrandHeroBrush}" ClipToBounds="True">
            <Grid>
                <!-- Decorative rings -->
                <Ellipse Width="360" Height="360" Stroke="#1AFFFFFF" StrokeThickness="40" Margin="0,0,-170,-150"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                <Ellipse Width="160" Height="160" Fill="#0FFFFFFF" Margin="0,-60,-40,0"
                         HorizontalAlignment="Right" VerticalAlignment="Top" />

                <DockPanel Margin="40,40,40,32">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="13" Background="#33FFFFFF">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE719;" FontSize="22" Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Run Text="Marg" /><Run Text="POS" Foreground="#99F6E4" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Text="Works alongside MARG ERP · your accounts stay in MARG"
                               Foreground="#B3FFFFFF" FontSize="11.5" TextWrapping="Wrap" />

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bill faster." Foreground="White" FontSize="34" FontWeight="Bold" />
                        <TextBlock Text="Track every batch." Foreground="#99F6E4" FontSize="34" FontWeight="Bold" Margin="0,-4,0,22" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BF;" Foreground="#99F6E4" Margin="0,0,12,0" />
                            <TextBlock Text="Barcode billing with keyboard shortcuts" Foreground="White" FontSize="13.5" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" Foreground="#99F6E4" Margin="0,0,12,0" />
                            <TextBlock Text="Batch, expiry and MRP on every line" Foreground="White" FontSize="13.5" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Foreground="#99F6E4" Margin="0,0,12,0" />
                            <TextBlock Text="Purchases flow straight into MARG" Foreground="White" FontSize="13.5" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="56,0">
            <TextBlock Text="Welcome back" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Sign in to open your counter" Style="{StaticResource Muted}" Margin="0,4,0,20" />

            <Border Style="{StaticResource ErrorBanner}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
            <Grid>
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="36,9,10,9"
                         AutomationProperties.Name="Username" />
                <TextBlock Style="{StaticResource SearchGlyph}" Text="&#xE77B;" />
            </Grid>

            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
            <Grid>
                <PasswordBox x:Name="PasswordBox" Padding="36,9,10,9" AutomationProperties.Name="Password" />
                <TextBlock Style="{StaticResource SearchGlyph}" Text="&#xE72E;" />
            </Grid>

            <Expander x:Name="ServerExpander" Margin="0,14,0,0">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" FontSize="13" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Server" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ServerUrl}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" Opacity="0.75" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="Server address (the shop's MargPOS server PC)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Server address" />
                </StackPanel>
            </Expander>

            <Grid Margin="0,24,0,0">
                <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top" Margin="0,-12,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Button IsDefault="True" HorizontalAlignment="Stretch" Padding="0,11" FontSize="15" FontWeight="SemiBold"
                        Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="Sign in"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Click="OnSignIn">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sign in" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="13" Margin="10,1,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Text="Press Enter to sign in" Style="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</Window>
