<Window x:Class="MargPos.Desktop.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" MinWidth="480" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24,20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="20" />

        <Border DockPanel.Dock="Top" Style="{StaticResource ErrorBanner}" MaxWidth="640" HorizontalAlignment="Stretch"
                Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
        </Border>

        <Grid DockPanel.Dock="Bottom" Margin="0,24,0,0">
            <TextBlock Text="Enter to save · Esc to cancel" Style="{StaticResource Muted}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" IsDefault="True" MinWidth="90" Style="{DynamicResource AccentButtonStyle}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Click="OnSave" />
                <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <ContentPresenter Content="{Binding}" />
    </DockPanel>
</Window>
