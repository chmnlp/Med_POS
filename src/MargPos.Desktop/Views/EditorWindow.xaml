<Window x:Class="MargPos.Desktop.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" MinWidth="480" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <!-- Brand stripe -->
        <Border DockPanel.Dock="Top" Height="4" Background="{DynamicResource BrandGradientBrush}" />

        <!-- Footer: shortcut hints + actions on a darker band, like a Fluent content dialog -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding SaveText}" IsDefault="True" MinWidth="100" Padding="16,7" Style="{DynamicResource AccentButtonStyle}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Click="OnSave" />
                    <Button Content="Cancel" IsCancel="True" MinWidth="90" Padding="16,7" Margin="8,0,0,0"
                            Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <ContentControl Style="{StaticResource ShortcutHint}" Content="Enter" Tag="confirm" />
                    <ContentControl Style="{StaticResource ShortcutHint}" Content="Esc" Tag="cancel" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Margin="24,18,24,20">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Border Style="{StaticResource IconBadge}" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="15" HorizontalAlignment="Center"
                               Foreground="{DynamicResource BrandBrush}" />
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource ErrorBanner}" MaxWidth="640" HorizontalAlignment="Stretch"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <ContentPresenter Content="{Binding}" />
        </DockPanel>
    </DockPanel>
</Window>
