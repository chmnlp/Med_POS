<UserControl x:Class="MargPos.Desktop.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MargPos.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="View" Tag="&#xE8A1;" ContentTemplate="{StaticResource IconContent}" Command="{Binding ViewCommand}" ToolTip="Enter" />
                <Button Content="Reprint" Tag="&#xE749;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0" Command="{Binding PrintCommand}" />
                <Button Content="Return items" Tag="&#xE7A7;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0" Command="{Binding ReturnCommand}" />
                <Button Content="Credit notes" Tag="&#xE8A5;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0" Command="{Binding CreditNotesCommand}" />
                <Button Content="Cancel bill" Tag="&#xE711;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0"
                        Command="{Binding CancelCommand}" ToolTip="Managers only; bills without returns" />
                <Button Content="Refresh" Tag="&#xE72C;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0" Command="{Binding RefreshCommand}" ToolTip="F5" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Grid Width="300">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,10,6" AutomationProperties.Name="Search" />
                    <TextBlock Style="{StaticResource SearchGlyph}" />
                    <TextBlock Text="Bill no., customer or phone  (Ctrl+F)" Style="{StaticResource Muted}"
                               Margin="36,0,12,0" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NoValueToVisibility}}" />
                </Grid>
                <TextBlock Text="From" Style="{StaticResource Muted}" Margin="16,0,8,0" />
                <DatePicker SelectedDate="{Binding FromDate}" Width="140" />
                <TextBlock Text="To" Style="{StaticResource Muted}" Margin="12,0,8,0" />
                <DatePicker SelectedDate="{Binding ToDate}" Width="140" />
                <Button Content="Today" Margin="8,0,0,0" Command="{Binding TodayCommand}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource ErrorBanner}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
        </Border>

        <DataGrid Grid.Row="2" x:Name="ListGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Bill no." Binding="{Binding InvoiceNo}" Width="140" />
                <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=dd-MM-yyyy HH:mm}" Width="140" />
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName, TargetNullValue=Walk-in customer}" Width="2*" />
                <DataGridTextColumn Header="Phone" Binding="{Binding CustomerPhone}" Width="120" />
                <DataGridTextColumn Header="Paid by" Binding="{Binding PaymentModes}" Width="*" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Total, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Credit due" Binding="{Binding BalanceDue, StringFormat=N2}" Width="100" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTemplateColumn Header="Status" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="4,0" VerticalAlignment="Center">
                                <Border x:Name="Paid" Style="{StaticResource ChipGreen}" Visibility="Collapsed"><TextBlock Text="Paid" /></Border>
                                <Border x:Name="Due" Style="{StaticResource ChipBlue}"><TextBlock Text="Credit due" /></Border>
                                <Border x:Name="Returned" Style="{StaticResource ChipAmber}" Visibility="Collapsed"><TextBlock Text="Partly returned" /></Border>
                                <Border x:Name="Cancelled" Style="{StaticResource ChipRed}" Visibility="Collapsed"><TextBlock Text="Cancelled" /></Border>
                            </Grid>
                            <!-- Later triggers win: cancelled > returned > settled (nothing due) > credit due -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding BalanceDue, Converter={StaticResource ZeroBlank}}" Value="">
                                    <Setter TargetName="Paid" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Due" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasReturns}" Value="True">
                                    <Setter TargetName="Paid" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Due" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Returned" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                    <Setter TargetName="Paid" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Due" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Returned" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Cancelled" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <views:EmptyState Grid.Row="2" Glyph="&#xE81C;" Title="No bills in this period"
                          Hint="Try a wider date range, or clear the search box."
                          Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="0,0,16,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
            <Button Tag="&#xE76B;" ContentTemplate="{StaticResource IconContent}" Content="Previous" Command="{Binding PreviousPageCommand}" />
            <Button Tag="&#xE76C;" ContentTemplate="{StaticResource IconContent}" Content="Next" Margin="8,0,0,0" Command="{Binding NextPageCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
