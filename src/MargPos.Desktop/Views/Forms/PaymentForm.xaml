<UserControl x:Class="MargPos.Desktop.Views.Forms.PaymentForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520">
    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16,12">
            <DockPanel>
                <TextBlock Text="To pay" Style="{StaticResource Muted}" FontSize="16" />
                <TextBlock Text="{Binding Total, StringFormat='₹ {0:N2}'}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Right"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </DockPanel>
        </Border>

        <UniformGrid Columns="4" Margin="0,12,0,0">
            <Button Content="All cash" Command="{Binding AllCashCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" Focusable="False" />
            <Button Content="All UPI" Command="{Binding AllUpiCommand}" HorizontalAlignment="Stretch" Margin="2,0" Focusable="False" />
            <Button Content="All card" Command="{Binding AllCardCommand}" HorizontalAlignment="Stretch" Margin="2,0" Focusable="False" />
            <Button Content="All credit" Command="{Binding AllCreditCommand}" HorizontalAlignment="Stretch" Margin="4,0,0,0" Focusable="False" />
        </UniformGrid>

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="Cash" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CashBox" Text="{Binding Cash, StringFormat=0.##, ValidatesOnExceptions=True}" FontSize="16" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="Cash received from customer" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Tendered, StringFormat=0.##, ValidatesOnExceptions=True}" FontSize="16" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="UPI" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Upi, StringFormat=0.##, ValidatesOnExceptions=True}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="UPI reference (optional)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding UpiReference}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Text="Card" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Card, StringFormat=0.##, ValidatesOnExceptions=True}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Text="Card approval / last 4 (optional)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding CardReference}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0">
                <TextBlock Text="Credit (customer account)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Credit, StringFormat=0.##, ValidatesOnExceptions=True}" IsEnabled="{Binding CanUseCredit}" />
            </StackPanel>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CreditHint}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                       VerticalAlignment="Bottom" Margin="0,0,0,6" />
        </Grid>

        <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Still to pay" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Remaining, StringFormat='₹ {0:N2}'}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Return change" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Change, StringFormat='₹ {0:N2}'}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
