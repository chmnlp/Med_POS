<UserControl x:Class="MargPos.Desktop.Views.Forms.SaleReturnForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="760">
    <StackPanel>
        <TextBlock Text="Enter the quantity coming back for each item." Style="{StaticResource Muted}" Margin="0,0,0,8" />
        <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Single" MaxHeight="320">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding Line.ItemName}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Batch" Binding="{Binding Line.BatchNo}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="Sold" Binding="{Binding Line.Qty, StringFormat=0.###}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Can return" Binding="{Binding Remaining, StringFormat=0.###}" Width="85" IsReadOnly="True" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Line.Amount, StringFormat=N2}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTemplateColumn Header="Return qty" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding ReturnQty, StringFormat=0.###, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Refund" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding RefundModes}" SelectedItem="{Binding RefundMode}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Reason}" />
            </StackPanel>
        </Grid>

        <TextBlock Margin="0,16,0,0" FontSize="16">
            Estimated refund: <Run Text="{Binding EstimatedRefund, Mode=OneWay, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" />
        </TextBlock>
    </StackPanel>
</UserControl>
