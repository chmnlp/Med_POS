<UserControl x:Class="MargPos.Desktop.Views.Forms.LabelPrintForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MargPos.Desktop.ViewModels"
             Width="1040">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- What to print -->
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="1 label each" Tag="&#xE8C4;" ContentTemplate="{StaticResource IconContent}"
                        Command="{Binding OneEachCommand}" ToolTip="Set every line to a single label, e.g. for a shelf" />
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center">
                    <Run Text="{Binding TotalLabels, Mode=OneWay}" /> label(s)
                </TextBlock>
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                       Text="Labels start at the stock in hand (or the quantity received). Type over Copies to change; 0 skips a line. Each batch gets its own barcode, so scanning a label at the counter bills that exact batch." />
            <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Height="380" AutoGenerateColumns="False"
                      SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding Label.ItemName}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Batch" Binding="{Binding Label.BatchNo, TargetNullValue='–'}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="Exp" Binding="{Binding Label.ExpiryDate, StringFormat=MM/yy}" Width="56" IsReadOnly="True" />
                    <DataGridTextColumn Header="MRP" Binding="{Binding Label.Mrp, StringFormat=N2}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Label.Barcode}" Width="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="In stock" Binding="{Binding Label.QtyOnHand, StringFormat=0.###}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="Copies" Binding="{Binding Copies, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="70"
                                        ElementStyle="{StaticResource NumberCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Label setup and preview -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="Label size (mm)" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal">
                <TextBox Width="70" Text="{Binding WidthMm, StringFormat=0.#, ValidatesOnExceptions=True}" AutomationProperties.Name="Label width in mm" />
                <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center" />
                <TextBox Width="70" Text="{Binding HeightMm, StringFormat=0.#, ValidatesOnExceptions=True}" AutomationProperties.Name="Label height in mm" />
                <TextBlock Text="Across" Margin="16,0,8,0" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                <ComboBox Width="70" ItemsSource="{x:Static vm:LabelPrintViewModel.AcrossChoices}" SelectedItem="{Binding LabelsAcross}"
                          ToolTip="Labels side by side on the roll" AutomationProperties.Name="Labels across" />
            </StackPanel>
            <CheckBox Content="Store name on top" IsChecked="{Binding ShowStoreName}" Margin="0,8,0,0" />
            <CheckBox Content="Show our rate next to MRP" IsChecked="{Binding ShowSaleRate}" />

            <TextBlock Text="Preview" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="16" Height="200">
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Border BorderBrush="#33000000" BorderThickness="1">
                        <ContentControl Content="{Binding Preview}" />
                    </Border>
                </Viewbox>
            </Border>

            <TextBlock Text="Label printer" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Choose…" Command="{Binding ChoosePrinterCommand}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding PrinterText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                       Text="In the printer's own settings, set the paper/stock to the same label size and the gap (or black mark) your roll uses." />
        </StackPanel>
    </Grid>
</UserControl>
