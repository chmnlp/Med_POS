<UserControl x:Class="MargPos.Desktop.Views.Forms.StatementForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="980">
    <StackPanel>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Print" Tag="&#xE749;" ContentTemplate="{StaticResource IconContent}" Command="{Binding PrintCommand}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="From" Style="{StaticResource Muted}" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding FromDate}" Width="140" />
                <TextBlock Text="To" Style="{StaticResource Muted}" Margin="12,0,8,0" />
                <DatePicker SelectedDate="{Binding ToDate}" Width="140" />
                <TextBlock Text="{Binding BalanceMeaning}" Style="{StaticResource Muted}" Margin="24,0,0,0" />
            </StackPanel>
        </DockPanel>
        <TextBlock Margin="0,0,0,6">
            Opening <Run Text="{Binding Statement.Opening, Mode=OneWay, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" />
        </TextBlock>
        <DataGrid ItemsSource="{Binding Statement.Entries}" Height="400" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd-MM-yyyy}" Width="95" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" />
                <DataGridTextColumn Header="Ref." Binding="{Binding RefNo}" Width="130" />
                <DataGridTextColumn Header="Details" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Debit" Binding="{Binding Debit, Converter={StaticResource ZeroBlank}}" Width="100" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Credit" Binding="{Binding Credit, Converter={StaticResource ZeroBlank}}" Width="100" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"><Setter Property="FontWeight" Value="SemiBold" /></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock HorizontalAlignment="Right" Margin="0,8,0,0" FontSize="16">
            Closing <Run Text="{Binding Statement.Closing, Mode=OneWay, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" />
        </TextBlock>
    </StackPanel>
</UserControl>
