<UserControl x:Class="MargPos.Desktop.Views.Forms.PurchaseForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1180">
    <StackPanel>
        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" /><ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                <ColumnDefinition Width="140" /><ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Supplier *" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="SupplierBox" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name"
                          IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Supplier invoice no. *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding SupplierInvoiceNo}" CharacterCasing="Upper" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Invoice date *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding InvoiceDateText}" ToolTip="dd-mm-yyyy" />
            </StackPanel>
            <Button Grid.Column="6" VerticalAlignment="Bottom" Content="Import EDE file…" Tag="&#xE8E5;"
                    ContentTemplate="{StaticResource IconContent}" Command="{Binding ImportEdeCommand}"
                    ToolTip="Load the distributor's electronic bill (H/T/F CSV) and check it here before saving" />
        </Grid>

        <Border Style="{StaticResource InfoBanner}" Margin="0,12,0,0" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Entry row -->
        <Border x:Name="EntryPanel" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12" PreviewKeyDown="OnEntryKeyDown">
            <StackPanel>
                <TextBlock Text="{Binding EntryHeading}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" /><ColumnDefinition Width="78" />
                        <ColumnDefinition Width="72" /><ColumnDefinition Width="62" />
                        <ColumnDefinition Width="84" /><ColumnDefinition Width="62" />
                        <ColumnDefinition Width="62" /><ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Text="Item (search)" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="Batch" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="Expiry" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="3" Text="Qty" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="4" Text="Free" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="5" Text="Rate (ex GST)" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="6" Text="Disc %" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="7" Text="GST %" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="8" Text="MRP" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="9" Text="Sale rate" Style="{StaticResource Muted}" FontSize="12" />

                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                        <TextBox x:Name="ItemSearchBox" Text="{Binding ItemQuery, UpdateSourceTrigger=PropertyChanged}" />
                        <Popup IsOpen="{Binding IsItemSearchOpen}" PlacementTarget="{Binding ElementName=ItemSearchBox}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" Width="520">
                            <Border Style="{StaticResource Card}" Padding="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                                <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" MaxHeight="300"
                                         BorderThickness="0" PreviewMouseLeftButtonUp="OnItemPicked">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                                    <Run Text="{Binding Code, Mode=OneWay}" /> · <Run Text="{Binding Pack, Mode=OneWay}" /> ·
                                                    <Run Text="{Binding Manufacturer, Mode=OneWay}" /> · stock <Run Text="{Binding StockQty, Mode=OneWay, StringFormat=0.###}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBox x:Name="BatchBox" Grid.Row="1" Grid.Column="1" Margin="0,0,6,0" Text="{Binding EntryBatch}"
                             CharacterCasing="Upper" IsEnabled="{Binding EntryIsBatchTracked}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,6,0" Text="{Binding EntryExpiry}" ToolTip="MM/YY"
                             IsEnabled="{Binding EntryIsBatchTracked}" />
                    <TextBox x:Name="QtyBox" Grid.Row="1" Grid.Column="3" Margin="0,0,6,0" Text="{Binding EntryQty, StringFormat=0.###, ValidatesOnExceptions=True}" />
                    <TextBox Grid.Row="1" Grid.Column="4" Margin="0,0,6,0" Text="{Binding EntryFree, StringFormat=0.###, ValidatesOnExceptions=True}" />
                    <TextBox Grid.Row="1" Grid.Column="5" Margin="0,0,6,0" Text="{Binding EntryRate, StringFormat=0.####, ValidatesOnExceptions=True}" />
                    <TextBox Grid.Row="1" Grid.Column="6" Margin="0,0,6,0" Text="{Binding EntryDiscount, StringFormat=0.##, ValidatesOnExceptions=True}" />
                    <TextBox Grid.Row="1" Grid.Column="7" Margin="0,0,6,0" Text="{Binding EntryGst, StringFormat=0.##, ValidatesOnExceptions=True}" />
                    <TextBox Grid.Row="1" Grid.Column="8" Margin="0,0,6,0" Text="{Binding EntryMrp, StringFormat=0.00, ValidatesOnExceptions=True}" />
                    <TextBox x:Name="SaleBox" Grid.Row="1" Grid.Column="9" Margin="0,0,6,0" Text="{Binding EntrySale, StringFormat=0.00, ValidatesOnExceptions=True}" />
                    <Button Grid.Row="1" Grid.Column="10" Content="Add line" Command="{Binding AddLineCommand}" Focusable="False" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Retail margin %" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,6,0" />
                    <TextBox x:Name="MarginBox" Width="64" Text="{Binding EntryMargin, StringFormat=0.##, ValidatesOnExceptions=True}"
                             ToolTip="Sale rate = landed cost × (1 + margin) × (1 + GST), capped at MRP" />
                    <TextBlock Text="Wholesale" Style="{StaticResource Muted}" FontSize="12" Margin="16,0,6,0" />
                    <TextBox x:Name="WholesaleBox" Width="80" Text="{Binding EntryWholesale, StringFormat=0.00, ValidatesOnExceptions=True}"
                             ToolTip="0 = item's wholesale margin or rate" />
                    <TextBlock Text="Hospital" Style="{StaticResource Muted}" FontSize="12" Margin="16,0,6,0" />
                    <TextBox x:Name="HospitalBox" Width="80" Text="{Binding EntryHospital, StringFormat=0.00, ValidatesOnExceptions=True}"
                             ToolTip="0 = wholesale rate" />
                    <TextBlock Text="{Binding EntryCostInfo}" Margin="16,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Muted}" FontSize="12"
                           Text="Enter moves to the next box; Enter on Sale rate (or the optional boxes below it) adds the line. A different MRP for an existing batch is kept as a separate lot. Ctrl+S saves." />
            </StackPanel>
        </Border>

        <!-- Lines -->
        <DockPanel Margin="0,12,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Edit / match line" Tag="&#xE70F;" ContentTemplate="{StaticResource IconContent}" Command="{Binding EditLineCommand}" />
                <Button Content="Remove line" Tag="&#xE74D;" ContentTemplate="{StaticResource IconContent}" Command="{Binding RemoveLineCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Lines.Count, StringFormat='Lines ({0})'}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Height="300" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" CanUserSortColumns="False"
                  MouseDoubleClick="OnLineDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding DisplayName}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMatched}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="100" />
                <DataGridTextColumn Header="Exp" Binding="{Binding ExpiryDate, StringFormat=MM/yy}" Width="60" />
                <DataGridTextColumn Header="Qty" Binding="{Binding Qty, StringFormat=0.###}" Width="60" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Free" Binding="{Binding FreeQty, StringFormat=0.###}" Width="55" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=0.00##}" Width="75" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercent, StringFormat=0.##}" Width="60" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="GST %" Binding="{Binding GstRate, StringFormat=0.##}" Width="60" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}" Width="75" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Sale" Binding="{Binding SaleRate, StringFormat=N2}" Width="75" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Landed" Binding="{Binding LandingCost, StringFormat=0.00##}" Width="75" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Taxable" Binding="{Binding Calc.Taxable, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="GST" Binding="{Binding Calc.Tax, StringFormat=N2}" Width="75" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Calc.Amount, StringFormat=N2}" Width="95" ElementStyle="{StaticResource NumberCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totals -->
        <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center">
                    Taxable <Run Text="{Binding Taxable, Mode=OneWay, StringFormat=N2}" /> · GST <Run Text="{Binding Tax, Mode=OneWay, StringFormat=N2}" />
                    · Round off <Run Text="{Binding RoundOff, Mode=OneWay, StringFormat=0.00}" />
                </TextBlock>
                <TextBlock Text="{Binding Total, StringFormat='₹ {0:N2}'}" FontSize="24" FontWeight="SemiBold" Margin="16,0,0,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding TotalCheck}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                           Visibility="{Binding TotalCheck, Converter={StaticResource HasValueToVisibility}}" />
                <Grid Width="420" HorizontalAlignment="Left">
                    <TextBox x:Name="NotesBox" Text="{Binding Notes}" />
                    <TextBlock Text="Notes (optional)" Style="{StaticResource Muted}" Margin="12,0" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=NotesBox, Converter={StaticResource NoValueToVisibility}}" />
                </Grid>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</UserControl>
