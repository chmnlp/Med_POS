<UserControl x:Class="MargPos.Desktop.Views.Forms.UserForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MargPos.Desktop.ViewModels"
             Width="420">
    <StackPanel>
        <TextBlock Text="Username *" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Username}" IsEnabled="{Binding IsNew}" />

        <TextBlock Text="Full name *" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding FullName}" />

        <TextBlock Text="Role" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{x:Static vm:Choices.Roles}" SelectedItem="{Binding Role}" />

        <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Temporary password * (they choose their own at first sign-in)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Password}" />
        </StackPanel>

        <CheckBox Content="Active (untick to block sign-in)" IsChecked="{Binding IsActive}" Margin="0,16,0,0"
                  Visibility="{Binding IsExisting, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
