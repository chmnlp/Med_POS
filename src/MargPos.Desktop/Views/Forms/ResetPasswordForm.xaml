<UserControl x:Class="MargPos.Desktop.Views.Forms.ResetPasswordForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420">
    <StackPanel>
        <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}"
                   Text="Give the user this temporary password. They will be signed out everywhere and must choose a new password at next sign-in." />
        <TextBlock Text="Temporary password *" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding NewPassword}" />
    </StackPanel>
</UserControl>
