<UserControl x:Class="MargPos.Desktop.Views.Forms.PurchaseDetailForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1000">
    <StackPanel>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
            <Run Text="{Binding Purchase.SupplierName, Mode=OneWay}" FontWeight="SemiBold" /> ·
            invoice <Run Text="{Binding Purchase.SupplierInvoiceNo, Mode=OneWay}" /> dated
            <Run Text="{Binding Purchase.SupplierInvoiceDate, Mode=OneWay, StringFormat=dd-MM-yyyy}" /> ·
            received <Run Text="{Binding Purchase.ReceivedAt, Mode=OneWay, StringFormat=dd-MM-yyyy HH:mm}" /> by
            <Run Text="{Binding Purchase.ReceivedBy, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Text="{Binding Purchase.CancelReason, StringFormat='Cancelled: {0}'}" Margin="0,6,0,0"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Visibility="{Binding Purchase.CancelReason, Converter={StaticResource HasValueToVisibility}}" />
        <DataGrid ItemsSource="{Binding Purchase.Lines}" Margin="0,12,0,0" Height="360" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="100" />
                <DataGridTextColumn Header="Exp" Binding="{Binding ExpiryDate, StringFormat=MM/yy}" Width="60" />
                <DataGridTextColumn Header="Qty" Binding="{Binding Qty, StringFormat=0.###}" Width="60" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Free" Binding="{Binding FreeQty, StringFormat=0.###}" Width="55" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=0.00##}" Width="75" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercent, StringFormat=0.##}" Width="60" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="GST %" Binding="{Binding GstRate, StringFormat=0.##}" Width="60" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat=N2}" Width="75" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="95" ElementStyle="{StaticResource NumberCell}" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock HorizontalAlignment="Right" Margin="0,12,0,0" FontSize="16">
            Taxable <Run Text="{Binding Purchase.Taxable, Mode=OneWay, StringFormat=N2}" /> · GST <Run Text="{Binding Purchase.Tax, Mode=OneWay, StringFormat=N2}" /> ·
            <Run Text="{Binding Purchase.Total, Mode=OneWay, StringFormat='Total ₹ {0:N2}'}" FontWeight="SemiBold" />
        </TextBlock>
    </StackPanel>
</UserControl>
