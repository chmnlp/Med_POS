<UserControl x:Class="MargPos.Desktop.Views.Forms.PurchaseReturnForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MargPos.Desktop.ViewModels"
             Width="1000">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Supplier *" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name"
                          IsEditable="True" TextSearch.TextPath="Name" IsEnabled="{Binding IsFreeStanding}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Reason}" />
            </StackPanel>
        </Grid>

        <!-- Free-standing returns: load the supplier's expiry stock, or add lots one by one -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12"
                Visibility="{Binding IsFreeStanding, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Load expiry returns" Tag="&#xE787;" ContentTemplate="{StaticResource IconContent}"
                            Command="{Binding LoadExpiryCommand}" ToolTip="Stock bought from this supplier that is expired or expiring soon" />
                    <TextBlock Text="expired or expiring within" Style="{StaticResource Muted}" Margin="12,0,8,0" />
                    <ComboBox ItemsSource="{x:Static vm:PurchaseReturnEditorViewModel.ExpiryWindows}" SelectedItem="{Binding ExpiryDays}" Width="80" />
                    <TextBlock Text="days" Style="{StaticResource Muted}" Margin="8,0,0,0" />
                </StackPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="280" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="ItemSearchBox" Text="{Binding ItemQuery, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnSearchKeyDown" />
                        <TextBlock Text="Or add one item: search by name / code" Style="{StaticResource Muted}" Margin="12,0" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=ItemSearchBox, Converter={StaticResource NoValueToVisibility}}" />
                        <Popup IsOpen="{Binding IsItemSearchOpen}" PlacementTarget="{Binding ElementName=ItemSearchBox}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" Width="480">
                            <Border Style="{StaticResource Card}" Padding="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                                <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" MaxHeight="280"
                                         BorderThickness="0" PreviewMouseLeftButtonUp="OnItemPicked" DisplayMemberPath="Name" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding EntryLots}" SelectedItem="{Binding EntryLot}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding BatchNo, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding ExpiryDate, Mode=OneWay, StringFormat=' exp {0:MM/yy}'}" />
                                    <Run Text="{Binding QtyOnHand, Mode=OneWay, StringFormat=' · {0:0.###} in stock'}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="4" Content="Add lot" Command="{Binding AddLotCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <DockPanel Margin="0,12,0,4">
            <Button DockPanel.Dock="Right" Content="Remove line" Tag="&#xE74D;" ContentTemplate="{StaticResource IconContent}" Command="{Binding RemoveLineCommand}" />
            <TextBlock Text="Lots going back — set the quantity for each" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Height="300" AutoGenerateColumns="False"
                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Lot" Binding="{Binding BatchNo}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=MM/yy}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource ExpiryCell}" />
                <DataGridTextColumn Header="Max" Binding="{Binding MaxQty, StringFormat=0.###}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTemplateColumn Header="Return qty" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Qty, StringFormat=0.###, ValidatesOnExceptions=True}" TextAlignment="Right" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Credit rate (ex GST)" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Rate, StringFormat=0.00##, ValidatesOnExceptions=True}" TextAlignment="Right" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="GST %" Binding="{Binding GstRate, StringFormat=0.##}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource NumberCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock HorizontalAlignment="Right" Margin="0,12,0,0" FontSize="16">
            Taxable <Run Text="{Binding Taxable, Mode=OneWay, StringFormat=N2}" /> · GST <Run Text="{Binding Tax, Mode=OneWay, StringFormat=N2}" /> ·
            <Run Text="{Binding Total, Mode=OneWay, StringFormat='Debit ₹ {0:N2}'}" FontWeight="SemiBold" />
        </TextBlock>
    </StackPanel>
</UserControl>
