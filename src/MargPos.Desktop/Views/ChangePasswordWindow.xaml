<Window x:Class="MargPos.Desktop.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change password" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="28,24">
        <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitle}" FontSize="20" />
        <TextBlock Text="Use at least 6 characters." Style="{StaticResource Muted}" Margin="0,0,0,12" />

        <Border Style="{StaticResource ErrorBanner}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
        </Border>

        <TextBlock Text="Current password" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="CurrentBox" />
        <TextBlock Text="New password" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="NewBox" />
        <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="ConfirmBox" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Change password" IsDefault="True" Style="{DynamicResource AccentButtonStyle}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Click="OnSubmit" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="8,0,0,0" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
