<UserControl x:Class="MargPos.Desktop.Views.PurchaseReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MargPos.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="New return" Tag="&#xE710;" ContentTemplate="{StaticResource IconContent}"
                        Style="{DynamicResource AccentButtonStyle}" Command="{Binding NewCommand}" ToolTip="F2 — expiry / breakage returns" />
                <Button Content="View / print" Tag="&#xE749;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0" Command="{Binding ViewCommand}" ToolTip="Enter" />
                <Button Content="Refresh" Tag="&#xE72C;" ContentTemplate="{StaticResource IconContent}" Margin="8,0,0,0" Command="{Binding RefreshCommand}" ToolTip="F5" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="0" Visibility="Collapsed" />
                <TextBlock Text="From" Style="{StaticResource Muted}" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding FromDate}" Width="140" />
                <TextBlock Text="To" Style="{StaticResource Muted}" Margin="12,0,8,0" />
                <DatePicker SelectedDate="{Binding ToDate}" Width="140" />
                <TextBlock Text="To return against a particular purchase, use Purchases → Return to supplier." Style="{StaticResource Muted}" Margin="24,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource ErrorBanner}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
        </Border>

        <DataGrid Grid.Row="2" x:Name="ListGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Debit note" Binding="{Binding ReturnNo}" Width="140" />
                <DataGridTextColumn Header="Date" Binding="{Binding ReturnDate, StringFormat=dd-MM-yyyy HH:mm}" Width="140" />
                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="2*" />
                <DataGridTextColumn Header="Against purchase" Binding="{Binding PurchaseNo}" Width="*" />
                <DataGridTextColumn Header="Lines" Binding="{Binding LineCount}" Width="60" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Amount" Binding="{Binding Total, StringFormat=N2}" Width="120" ElementStyle="{StaticResource NumberCell}" />
            </DataGrid.Columns>
        </DataGrid>
        <views:EmptyState Grid.Row="2" Glyph="&#xE7A7;" Title="No supplier returns in this period" Hint="Return expired or damaged stock to a supplier to raise a debit note." Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
            <Button Tag="&#xE76B;" ContentTemplate="{StaticResource IconContent}" Content="Previous" Command="{Binding PreviousPageCommand}" />
            <Button Tag="&#xE76C;" ContentTemplate="{StaticResource IconContent}" Content="Next" Margin="8,0,0,0" Command="{Binding NextPageCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
